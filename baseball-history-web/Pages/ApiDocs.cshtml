    @page
@model ApiDocsModel
@{
    ViewData["Title"] = "API Documentation";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        @await Html.PartialAsync("Components/_PageHeader", new baseball_history_web.ViewModels.PageHeaderModel
        {
            Title = "REST API",
            Subtitle = "Access over 150 years of Major League Baseball statistics programmatically. All endpoints return JSON and require no authentication.",
            Eyebrow = "Developer"
        })

        <div class="alert alert-info d-flex align-items-center mb-4">
            <span class="me-2" style="font-size: 1.2rem;">&#128214;</span>
            <div>
                <strong>Interactive API Explorer:</strong>
                Try endpoints directly in the
                <a href="/scalar/v1" target="_blank" rel="noopener">Scalar API Reference</a>
                or view the raw
                <a href="/openapi/v1.json" target="_blank" rel="noopener">OpenAPI specification</a>.
            </div>
        </div>

        <!-- Base URL -->
        <section class="mb-5">
                <h2>Base URL</h2>
                <pre class="bg-dark text-light p-3 rounded"><code>https://baseballhistoryproject.com/api</code></pre>
                <p>All endpoints below are relative to this base. Responses use <code>application/json</code>.</p>
        </section>

            <!-- Pagination -->
            <section class="mb-5">
                <h2>Pagination</h2>
                <p>List endpoints return a standard pagination envelope:</p>
                <pre class="bg-dark text-light p-3 rounded"><code>{
                  "data": [ ... ],
                  "page": 1,
                  "pageSize": 25,
                  "totalCount": 1234,
                  "totalPages": 50
                }</code></pre>
                <p>
                    Use <code>page</code> and <code>pageSize</code> query parameters to navigate.
                    Maximum <code>pageSize</code> is 100.
                </p>
            </section>

            <!-- Players -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Players</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players</code></h5>
                    <p>
                        List players by last name initial, with the same name, position, and era
                        filters as the <a href="/Players">Players</a> browser. Paginated.
                    </p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>letter</code></td><td>string</td><td>A</td><td>Last name initial (A-Z); ignored when <code>q</code> is set</td></tr>
                            <tr><td><code>q</code></td><td>string</td><td>&mdash;</td><td>Full-name search across all letters (case-insensitive)</td></tr>
                            <tr><td><code>pos</code></td><td>string</td><td>&mdash;</td><td>Position ever played: <code>P</code>, <code>C</code>, <code>1B</code>, <code>2B</code>, <code>3B</code>, <code>SS</code>, <code>OF</code> (includes LF/CF/RF), <code>DH</code></td></tr>
                            <tr><td><code>era</code></td><td>int</td><td>&mdash;</td><td>Decade (e.g. <code>1920</code>; any year in it works). Keeps players active during that decade</td></tr>
                            <tr><td><code>sort</code></td><td>string</td><td>name</td><td><code>name</code>, <code>hr</code>, <code>hits</code>, or <code>games</code> (career totals, descending)</td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>25</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Examples:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/players?letter=R&amp;page=1&amp;pageSize=10"</code></pre>
                    <p>Shortstops active in the 1920s, by career home runs:</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/players?pos=SS&amp;era=1920&amp;sort=hr"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}</code></h5>
                    <p>
                        Full player detail including career batting/pitching stats, teams played for, and Hall of Fame status.
                        Also includes <code>careerOpsIndex</code> (career OPS vs. league, 100 = average), <code>careerQualified</code>,
                        <code>allStarSelections</code> (distinct All-Star seasons), and <code>hasManagerialCareer</code>.
                    </p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/players/ruthba01"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/batting</code></h5>
                    <p>Season-by-season batting statistics with team names and computed batting average.</p>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/batting/advanced</code></h5>
                    <p>Season advanced batting, one row per season with stints combined: plate appearances, ISO, BABIP, BB%, K%, <code>opsIndex</code> (OPS vs. league, 100 = average, not park-adjusted), HR per 162 games, and season-relative qualification (3.1 PA per team game). A stat is <code>null</code> when its inputs weren&rsquo;t recorded that season.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/players/ruthba01/batting/advanced"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/pitching</code></h5>
                    <p>Season-by-season pitching statistics with ERA.</p>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/pitching/advanced</code></h5>
                    <p>
                        Season advanced pitching, one row per season with stints combined: games, starts, innings,
                        ERA, WHIP, K/9, BB/9, and season-relative qualification (1 IP per team game).
                    </p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/players/johnswa01/pitching/advanced"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/fielding</code></h5>
                    <p>Season-by-season fielding stats by position (putouts, assists, errors, double plays).</p>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/awards</code></h5>
                    <p>All awards won (MVP, Cy Young, Gold Glove, etc.).</p>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/all-star</code></h5>
                    <p>All-Star Game selections, newest first, with team, whether the player started (and at which position number), and whether the player appeared in the game.</p>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/managing</code></h5>
                    <p>Managerial stints (the player page&rsquo;s Managing tab): team, in-season order, record, finish, and pennant/World Series flags. Returns an empty array for players who never managed.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/players/torrejo01/managing"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/postseason/batting</code></h5>
                    <p>Postseason batting stats by year and round (ALCS, NLCS, WS, etc.).</p>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/players/{playerId}/postseason/pitching</code></h5>
                    <p>Postseason pitching stats by year and round.</p>
                </div>
            </section>

            <!-- Teams -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Teams</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/teams/franchises</code></h5>
                    <p>
                        List all franchises with all-time records, championships, and pennants, with the same name and
                        era filters as the <a href="/Teams">Teams</a> browser.
                    </p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>league</code></td><td>string</td><td>&mdash;</td><td>Filter by league (AL, NL)</td></tr>
                            <tr><td><code>activeOnly</code></td><td>bool</td><td>false</td><td>Only active franchises</td></tr>
                            <tr><td><code>q</code></td><td>string</td><td>&mdash;</td><td>Franchise name contains (case-insensitive)</td></tr>
                            <tr><td><code>era</code></td><td>int</td><td>&mdash;</td><td>Decade (e.g. <code>1900</code>). Keeps franchises that fielded a team during it</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Examples:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/teams/franchises?league=AL&amp;activeOnly=true"</code></pre>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/teams/franchises?q=giants&amp;era=1930"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/teams/franchises/{franchiseId}</code></h5>
                    <p>Franchise detail with every season's record, division/pennant/World Series wins.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/teams/franchises/NYY"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/teams/seasons/{teamId}/{lgId}/{year}</code></h5>
                    <p>
                        Complete team season: record, batting/pitching aggregates, full roster
                        (batters and pitchers), and managers. Includes Hall of Fame flags.
                    </p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/teams/seasons/NYA/AL/1927"</code></pre>
                </div>
            </section>

            <!-- Leaders -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Leaders</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/leaders/batting</code></h5>
                    <p>Batting leaderboard ranked by any stat. Supports career and single-season modes.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>stat</code></td><td>string</td><td>hr</td><td>Stat to sort by: <code>hr</code>, <code>h</code>, <code>avg</code>, <code>r</code>, <code>rbi</code>, <code>sb</code>, <code>bb</code>, <code>ops</code>, <code>obp</code>, <code>slg</code>, <code>2b</code>, <code>3b</code>, <code>g</code>, <code>ab</code></td></tr>
                            <tr><td><code>fromYear</code></td><td>int</td><td>&mdash;</td><td>Start year</td></tr>
                            <tr><td><code>toYear</code></td><td>int</td><td>&mdash;</td><td>End year</td></tr>
                            <tr><td><code>league</code></td><td>string</td><td>&mdash;</td><td>League filter (AL, NL)</td></tr>
                            <tr><td><code>qualified</code></td><td>bool</td><td>true</td><td>Apply season-relative qualification for rate stats (AVG, OBP, SLG, OPS); ignored for counting stats</td></tr>
                            <tr><td><code>minAb</code></td><td>int</td><td>&mdash;</td><td>Explicit minimum at-bats (overrides qualification)</td></tr>
                            <tr><td><code>singleSeason</code></td><td>bool</td><td>false</td><td>Single season vs. career totals</td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Qualification for rate stats:</strong> When <code>qualified=true</code> (default), the threshold is computed relative to each player's career games played: total plate appearances must equal or exceed 3.1 PA per team-game across all stints, with a minimum floor of 100 PA. This season-relative logic allows players from shorter-season eras (Negro Leagues, 19th century) to qualify naturally without needing arbitrary career totals. Set <code>qualified=false</code> to see all players including small-sample outliers, or provide an explicit <code>minAb</code> value to override automatic qualification.</p>
                    <p><strong>Example:</strong> Career batting average leaders (qualified):</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/leaders/batting?stat=avg&amp;qualified=true"</code></pre>
                    <p><strong>Example:</strong> Career batting average, all players (no qualification):</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/leaders/batting?stat=avg&amp;qualified=false"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/leaders/pitching</code></h5>
                    <p>Pitching leaderboard. ERA and WHIP sort ascending (lower is better); all others descending.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>stat</code></td><td>string</td><td>w</td><td>Stat to sort by: <code>w</code>, <code>so</code>, <code>sv</code>, <code>era</code>, <code>whip</code>, <code>g</code>, <code>gs</code>, <code>cg</code>, <code>sho</code>, <code>ip</code>, <code>hr</code>, <code>k9</code>, <code>bb9</code>, <code>wpct</code></td></tr>
                            <tr><td><code>fromYear</code></td><td>int</td><td>&mdash;</td><td>Start year</td></tr>
                            <tr><td><code>toYear</code></td><td>int</td><td>&mdash;</td><td>End year</td></tr>
                            <tr><td><code>league</code></td><td>string</td><td>&mdash;</td><td>League filter (AL, NL)</td></tr>
                            <tr><td><code>qualified</code></td><td>bool</td><td>true</td><td>Apply season-relative qualification for rate stats (ERA, WHIP, K9, BB9, WPCT); ignored for counting stats</td></tr>
                            <tr><td><code>minIp</code></td><td>int</td><td>&mdash;</td><td>Explicit minimum innings pitched (overrides qualification)</td></tr>
                            <tr><td><code>singleSeason</code></td><td>bool</td><td>false</td><td>Single season vs. career totals</td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Qualification for rate stats:</strong> When <code>qualified=true</code> (default), the threshold is computed relative to each player's career games played: total outs pitched must equal or exceed 3.0 outs per team-game across all stints (equivalent to 1 inning per game), with a minimum floor of 90 outs (30 innings). This season-relative logic allows pitchers from shorter-season eras to qualify naturally without needing arbitrary career inning totals. Set <code>qualified=false</code> to see all pitchers including small-sample outliers, or provide an explicit <code>minIp</code> value to override automatic qualification.</p>
                    <p><strong>Example:</strong> Career ERA leaders (qualified):</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/leaders/pitching?stat=era&amp;qualified=true"</code></pre>
                    <p><strong>Example:</strong> Career strikeout leaders with explicit minimum of 1000 IP:</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/leaders/pitching?stat=so&amp;minIp=1000"</code></pre>
                </div>
            </section>

            <!-- Hall of Fame -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Hall of Fame</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/hall-of-fame</code></h5>
                    <p>List Hall of Fame inductees with vote percentages.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>year</code></td><td>int</td><td>&mdash;</td><td>Induction year</td></tr>
                            <tr><td><code>category</code></td><td>string</td><td>&mdash;</td><td>Category: <code>Player</code>, <code>Manager</code>, <code>Pioneer/Executive</code>, <code>Umpire</code></td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/hall-of-fame/{playerId}/voting</code></h5>
                    <p>Complete voting history for a player across all ballot years.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/hall-of-fame/jeterda01/voting"</code></pre>
                </div>
            </section>

            <!-- Search -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Search</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/search</code></h5>
                    <p>Search across players and franchises by name. Returns both result types with total counts.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>q</code></td><td>string</td><td><em>required</em></td><td>Search query (min 2 characters)</td></tr>
                            <tr><td><code>limit</code></td><td>int</td><td>10</td><td>Max results per type (max 50)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/search?q=griffey"</code></pre>
                </div>
            </section>

            <!-- Salaries -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Salaries</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/salaries/players/{playerId}</code></h5>
                    <p>Player salary history with career total. Data available from 1985 onward.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/salaries/players/troutmi01"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/salaries/teams/{teamId}/{year}</code></h5>
                    <p>Team payroll breakdown for a given season.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/salaries/teams/NYA/2014"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/salaries/leaders</code></h5>
                    <p>Highest-paid players. Paginated.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>year</code></td><td>int</td><td>&mdash;</td><td>Filter to a specific year</td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Parks -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Ballparks</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/parks</code></h5>
                    <p>List all ballparks. Paginated.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>state</code></td><td>string</td><td>&mdash;</td><td>Filter by state code</td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/parks/{parkKey}</code></h5>
                    <p>Park detail with season-by-season attendance and game counts.</p>
                </div>
            </section>

            <!-- Postseason -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Postseason</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/postseason/series</code></h5>
                    <p>Postseason series results (World Series, LCS, Division Series, Wild Card). Paginated.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>year</code></td><td>int</td><td>&mdash;</td><td>Filter by year</td></tr>
                            <tr><td><code>round</code></td><td>string</td><td>&mdash;</td><td>Filter by round (WS, ALCS, NLCS, ALDS, NLDS, ALWC, NLWC)</td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Example:</strong> All World Series results:</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/postseason/series?round=WS&amp;pageSize=100"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/postseason/series/{year}</code></h5>
                    <p>All postseason series for a given year.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/postseason/series/2024"</code></pre>
                </div>
            </section>

            <!-- Awards -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Awards</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/awards/winners</code></h5>
                    <p>Award winners with optional filters. Paginated.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>awardId</code></td><td>string</td><td>&mdash;</td><td>Filter by award (e.g. <code>MVP</code>, <code>Cy Young</code>, <code>Gold Glove</code>)</td></tr>
                            <tr><td><code>year</code></td><td>int</td><td>&mdash;</td><td>Filter by year</td></tr>
                            <tr><td><code>lgId</code></td><td>string</td><td>&mdash;</td><td>Filter by league (AL, NL)</td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Example:</strong> All AL MVP winners:</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/awards/winners?awardId=MVP&amp;lgId=AL"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/awards/voting/{awardId}/{year}/{lgId}</code></h5>
                    <p>
                        Full voting breakdown for an award race. Shows every candidate with points won,
                        max possible, first-place votes, and vote share percentage.
                    </p>
                    <p><strong>Example:</strong> 2023 AL MVP voting race:</p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/awards/voting/MVP/2023/AL"</code></pre>
                </div>
            </section>

            <!-- Managers -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Managers</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/managers</code></h5>
                    <p>Managers with career records and Hall of Fame flags. Paginated.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>q</code></td><td>string</td><td>&mdash;</td><td>First or last name contains (case-insensitive)</td></tr>
                            <tr><td><code>sort</code></td><td>string</td><td>wins</td><td><code>wins</code> (career wins, descending) or <code>name</code></td></tr>
                            <tr><td><code>page</code></td><td>int</td><td>1</td><td>Page number</td></tr>
                            <tr><td><code>pageSize</code></td><td>int</td><td>50</td><td>Results per page (max 100)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/managers?q=mack&amp;sort=name"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/managers/{playerId}</code></h5>
                    <p>A manager&rsquo;s career: totals, pennants and World Series titles, every season stint, split-season halves (1892, 1981), and manager awards with whether voting data exists. Returns 404 for people who never managed.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/managers/mackco01"</code></pre>
                </div>
            </section>

            <!-- All-Star Games -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">All-Star Games</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/all-star</code></h5>
                    <p>Every All-Star season, newest first, with game count, distinct selections, and whether the Negro Leagues East-West Game was played that year (1933&ndash;1948).</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/all-star"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/all-star/{year}</code></h5>
                    <p>One season&rsquo;s games (two AL&ndash;NL games in 1959&ndash;1962) with rosters by league or squad. <code>gameType</code> is <code>AllStar</code>, <code>EastWest</code>, or <code>NorthSouth</code>. Starters are listed first with their position; <code>teamLgId</code> is the club&rsquo;s season league, which differs from the squad code in Negro Leagues games.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/all-star/1943"</code></pre>
                </div>
            </section>

            <!-- Negro Leagues -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Negro Leagues</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/negro-leagues</code></h5>
                    <p>The seven Negro Leagues (1920&ndash;1948) MLB recognizes as major leagues, with years, a summary, team-season and club counts.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/negro-leagues"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/negro-leagues/{lgId}</code></h5>
                    <p>A league&rsquo;s seasons (with champions) and its clubs&rsquo; aggregate records. <code>lgId</code> is <code>NNL</code>, <code>ECL</code>, <code>ANL</code>, <code>EWL</code>, <code>NSL</code>, <code>NN2</code>, or <code>NAL</code> (case-insensitive).</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/negro-leagues/NN2"</code></pre>
                </div>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/negro-leagues/{lgId}/{year}</code></h5>
                    <p>Season standings with games behind, plus the top five in batting average and ERA (qualified) and home runs and wins. Leader values are numeric.</p>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/negro-leagues/NN2/1943"</code></pre>
                </div>
            </section>

            <!-- This Day in Baseball -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">This Day in Baseball</h2>

                <div class="api-endpoint mb-4">
                    <h5><rhx-badge rhx-variant="success" class="me-2">GET</rhx-badge><code>/api/this-day</code></h5>
                    <p>Birthdays, debuts, and final games on a calendar day &mdash; the data behind the home page widget. Hall of Famers rank first, then the most recent.</p>
                    <table class="table table-sm">
                        <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
                        <tbody>
                            <tr><td><code>date</code></td><td>string</td><td>today</td><td>Month and day as <code>MM-DD</code> (e.g. <code>02-06</code>; <code>02-29</code> allowed)</td></tr>
                            <tr><td><code>limit</code></td><td>int</td><td>5</td><td>Entries per category (1&ndash;25)</td></tr>
                        </tbody>
                    </table>
                    <p><strong>Example:</strong></p>
                    <pre class="bg-dark text-light p-3 rounded"><code>curl "https://baseballhistoryproject.com/api/this-day?date=02-06&amp;limit=10"</code></pre>
                </div>
            </section>

            <!-- Response Codes -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Response Codes</h2>
                <table class="table table-sm">
                    <thead><tr><th>Code</th><th>Meaning</th></tr></thead>
                    <tbody>
                        <tr><td><code>200</code></td><td>Success</td></tr>
                        <tr><td><code>400</code></td><td>Bad request (e.g. search query too short, or an unrecognized filter value such as <code>pos=XX</code>)</td></tr>
                        <tr><td><code>404</code></td><td>Resource not found</td></tr>
                    </tbody>
                </table>
            </section>

            <!-- Data Notes -->
            <section class="mb-5">
                <h2 class="border-bottom pb-2">Data Notes</h2>
                <ul>
                    <li>All data is from the <a href="https://sabr.org/lahman-database/" target="_blank" rel="noopener">Lahman Baseball Database</a>, covering 1871 to 2025.</li>
                    <li>Data obtained through the API carries the source licenses and attribution requirements &mdash; see <a href="/Licensing">Data Licensing &amp; Attribution</a>.</li>
                    <li>The database is read-only. All endpoints are <code>GET</code> requests.</li>
                    <li>Player IDs follow the Lahman convention (e.g. <code>ruthba01</code>, <code>jeterda01</code>, <code>troutmi01</code>).</li>
                    <li>Franchise IDs match Lahman franchise codes (e.g. <code>NYY</code>, <code>BOS</code>, <code>LAD</code>).</li>
                    <li>Computed stats (AVG, OBP, SLG, OPS, ERA, WHIP) are calculated server-side and returned as rounded doubles.</li>
                    <li>Salary data is available from 1985 onward.</li>
                    <li>Innings pitched is stored as outs in the database and converted to innings (outs / 3) in responses.</li>
                </ul>
            </section>
    </div>
</div>
