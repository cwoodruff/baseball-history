@using baseball_history_web.Extensions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Baseball History</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg"/>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico"/>
    <script type="importmap"></script>
    <script>
        // Apply the saved theme before first paint to avoid a flash.
        // Light is always the default — dark mode is strictly opt-in via the
        // navbar toggle, never inferred from the OS preference.
        (function () {
            var theme = localStorage.getItem('bb-theme') === 'dark' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/team-colors.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/baseball_history_web.styles.css" asp-append-version="true"/>
    @* htmxRazor injects its foundation CSS automatically. Import component CSS here as pages adopt rhx-* tag helpers. *@
    <link rel="stylesheet" href="/_rhx/css/components/rhx-button.css" />
    <link rel="stylesheet" href="/_rhx/css/components/rhx-badge.css" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DK1MZLFLXT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DK1MZLFLXT');
    </script>

    <!-- Scripts in head so they survive hx-boost body swaps -->
    @* htmx is injected by AddhtmxRazor(); keep global runtime scripts here so shell behavior survives hx-boost swaps. *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/lib/chartjs/dist/chart.umd.js" defer></script>
</head>
<body hx-boost="true">
<a class="skip-link" href="#main-content">Skip to main content</a>
@await Html.PartialAsync("_ShellHeader")

<div class="container mt-4">
    <main role="main" class="pb-3" id="main-content">
        @RenderBody()
    </main>
</div>

<div id="modal-container"></div>
<div id="modal-loading" class="modal-loading-overlay">
    @await Html.PartialAsync("Components/_LoadingSpinner", "Loading player...")
</div>

<button type="button" id="back-to-top" class="back-to-top" aria-label="Back to top" title="Back to top">
    <span aria-hidden="true">&uarr;</span>
</button>

@await Html.PartialAsync("_ShellFooter")

<script>
    // Runs once on initial load — listeners on document persist across hx-boost swaps
    if (!window.__bbHistoryInit) {
        window.__bbHistoryInit = true;

        // Clean up any existing modals before loading new ones
        function cleanupModals() {
            document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
                backdrop.remove();
            });
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('padding-right');
            document.body.style.removeProperty('overflow');
        }

        document.addEventListener('htmx:beforeSwap', function (evt) {
            if (evt.detail.target.id === 'modal-container') {
                var existingModal = evt.detail.target.querySelector('.modal');
                if (existingModal) {
                    var existingInstance = bootstrap.Modal.getInstance(existingModal);
                    if (existingInstance) {
                        existingInstance.dispose();
                    }
                }
                cleanupModals();
            } else if (evt.detail.target === document.body && document.body.classList.contains('modal-open')) {
                // Boosted navigation from a link inside an open modal: the swap
                // replaces the modal markup but leaves the body scroll-lock behind
                var openModal = document.querySelector('#modal-container .modal');
                if (openModal) {
                    var openInstance = bootstrap.Modal.getInstance(openModal);
                    if (openInstance) {
                        openInstance.dispose();
                    }
                }
                cleanupModals();
            }
        });

        document.addEventListener('htmx:afterSwap', function (evt) {
            // Initialize any Bootstrap modals loaded via HTMX
            if (evt.detail.target.id === 'modal-container') {
                var modal = evt.detail.target.querySelector('.modal');
                if (modal) {
                    cleanupModals();
                    setTimeout(function() {
                        var bsModal = new bootstrap.Modal(modal, {
                            backdrop: true,
                            keyboard: true
                        });
                        bsModal.show();
                        modal.addEventListener('hidden.bs.modal', function () {
                            try { bsModal.dispose(); } catch (e) {}
                            document.getElementById('modal-container').innerHTML = '';
                            cleanupModals();
                        }, { once: true });
                    }, 10);
                }
            }

            // Reinitialize Bootstrap dropdowns after any swap
            var dropdowns = document.querySelectorAll('[data-bs-toggle="dropdown"]');
            dropdowns.forEach(function (dropdown) {
                var instance = bootstrap.Dropdown.getInstance(dropdown);
                if (instance) {
                    instance.dispose();
                }
                new bootstrap.Dropdown(dropdown);
            });
        });

        document.addEventListener('htmx:afterSettle', function (evt) {
            var dropdowns = document.querySelectorAll('[data-bs-toggle="dropdown"]');
            dropdowns.forEach(function (dropdown) {
                var instance = bootstrap.Dropdown.getInstance(dropdown);
                if (instance) {
                    instance.dispose();
                }
                new bootstrap.Dropdown(dropdown);
            });
        });

        // Hide search results when clicking outside (handles both single and multi-search)
        document.addEventListener('click', function (e) {
            var searchContainer = document.querySelector('.search-container');
            var searchResults = document.getElementById('search-results');
            if (searchContainer && !searchContainer.contains(e.target) && searchResults) {
                searchResults.innerHTML = '';
            }
            
            // Handle Compare page multiple search dropdowns
            var allSearchResults = document.querySelectorAll('[id^="search-results"]');
            allSearchResults.forEach(function(resultsDiv) {
                if (resultsDiv.id === 'search-results') return; // Already handled above
                var parent = resultsDiv.closest('.card-body, .position-relative');
                if (parent && !parent.contains(e.target)) {
                    resultsDiv.innerHTML = '';
                }
            });
        });
        
        // Close search dropdowns on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                var allSearchResults = document.querySelectorAll('[id^="search-results"]');
                allSearchResults.forEach(function(resultsDiv) {
                    resultsDiv.innerHTML = '';
                });
            }
        });

        window.addEventListener('beforeunload', function() {
            cleanupModals();
        });

        // Show a loading overlay while any modal content is being fetched.
        // Hiding cannot rely only on htmx:afterRequest: that event fires on the
        // requesting element, which some triggers (e.g. search results) remove
        // from the DOM before the response lands, so it never bubbles here.
        // htmx:beforeSwap/afterSwap fire on #modal-container itself, which is
        // always attached; a failsafe timer covers error paths.
        var modalLoadingTimer = null;
        function setModalLoading(on) {
            var overlay = document.getElementById('modal-loading');
            if (overlay) overlay.classList.toggle('show', on);
            if (modalLoadingTimer) {
                clearTimeout(modalLoadingTimer);
                modalLoadingTimer = null;
            }
            if (on) {
                modalLoadingTimer = setTimeout(function () { setModalLoading(false); }, 8000);
            }
        }

        document.addEventListener('htmx:beforeRequest', function (evt) {
            if (evt.detail.target && evt.detail.target.id === 'modal-container') {
                setModalLoading(true);
            }
        });

        ['htmx:beforeSwap', 'htmx:afterRequest', 'htmx:sendError', 'htmx:responseError', 'htmx:timeout'].forEach(function (name) {
            document.addEventListener(name, function (evt) {
                if (evt.detail.target && evt.detail.target.id === 'modal-container') {
                    setModalLoading(false);
                }
            });
        });

        // Back-to-top button (delegated so it survives hx-boost swaps)
        window.addEventListener('scroll', function () {
            var backToTop = document.getElementById('back-to-top');
            if (backToTop) backToTop.classList.toggle('show', window.scrollY > 600);
        }, { passive: true });

        document.addEventListener('click', function (e) {
            if (e.target.closest('#back-to-top')) {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

        // Theme toggle (button lives in the navbar, delegated so it survives hx-boost swaps)
        document.addEventListener('click', function (e) {
            var toggle = e.target.closest('#theme-toggle');
            if (!toggle) return;
            var next = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', next);
            localStorage.setItem('bb-theme', next);
        });
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
