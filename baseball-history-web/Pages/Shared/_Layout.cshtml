@using baseball_history_web.Extensions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Baseball History</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg"/>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico"/>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/team-colors.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/baseball_history_web.styles.css" asp-append-version="true"/>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DK1MZLFLXT"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DK1MZLFLXT');
    </script>

    <!-- Scripts in head so they survive hx-boost body swaps -->
    <script src="https://unpkg.com/htmx.org@2.0.4"
            integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
            crossorigin="anonymous"
            defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body hx-boost="true">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mlb">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">
                <span class="me-2">&#9918;</span>Baseball History
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Players/Index">Players</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Teams/Index">Teams</a>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle" id="statsDropdown"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            Stats
                        </button>
                        <ul class="dropdown-menu shadow" aria-labelledby="statsDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-page="/Stats/Batting">Batting Leaders</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/Stats/Pitching">Pitching Leaders</a>
                            </li>
                            <li>
                                <hr class="dropdown-divider"/>
                            </li>
                            <li><a class="dropdown-item" asp-area="" asp-page="/HallOfFame/Index">Hall of Fame</a></li>
                        </ul>
                    </li>
                </ul>
                <div class="search-container">
                    <input type="search" class="form-control" placeholder="Search players, teams..."
                           name="q"
                           hx-get="/Search"
                           hx-trigger="input changed delay:300ms, search"
                           hx-target="#search-results"
                           hx-swap="innerHTML"
                           autocomplete="off"/>
                    <div id="search-results" class="search-results-dropdown"></div>
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container mt-4">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<div id="modal-container"></div>

<footer class="footer-mlb mt-auto">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <span>&copy; @DateTime.Now.Year Baseball History</span>
                <span class="mx-2">|</span>
                <span>Data from the <a href="https://sabr.org/lahman-database/" target="_blank">Lahman Baseball Database</a></span>
            </div>
            <div class="col-md-6 text-md-end">
                <a asp-area="" asp-page="/About">About</a>
                <span class="mx-2">|</span>
                <a asp-area="" asp-page="/Privacy">Privacy</a>
                <span class="mx-2">|</span>
                <a asp-area="" asp-page="/Health">Health Check</a>
                <span class="mx-2">|</span>
                <a href="https://github.com/cwoodruff/baseball-history" target="_blank" rel="noopener">GitHub</a>
            </div>
        </div>
    </div>
</footer>

<script>
    // Runs once on initial load — listeners on document persist across hx-boost swaps
    if (!window.__bbHistoryInit) {
        window.__bbHistoryInit = true;

        // Clean up any existing modals before loading new ones
        function cleanupModals() {
            document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
                backdrop.remove();
            });
            document.body.classList.remove('modal-open');
            document.body.style.removeProperty('padding-right');
            document.body.style.removeProperty('overflow');
        }

        document.addEventListener('htmx:beforeSwap', function (evt) {
            if (evt.detail.target.id === 'modal-container') {
                var existingModal = evt.detail.target.querySelector('.modal');
                if (existingModal) {
                    var existingInstance = bootstrap.Modal.getInstance(existingModal);
                    if (existingInstance) {
                        existingInstance.dispose();
                    }
                }
                cleanupModals();
            }
        });

        document.addEventListener('htmx:afterSwap', function (evt) {
            // Initialize any Bootstrap modals loaded via HTMX
            if (evt.detail.target.id === 'modal-container') {
                var modal = evt.detail.target.querySelector('.modal');
                if (modal) {
                    cleanupModals();
                    setTimeout(function() {
                        var bsModal = new bootstrap.Modal(modal, {
                            backdrop: true,
                            keyboard: true
                        });
                        bsModal.show();
                        modal.addEventListener('hidden.bs.modal', function () {
                            try { bsModal.dispose(); } catch (e) {}
                            document.getElementById('modal-container').innerHTML = '';
                            cleanupModals();
                        }, { once: true });
                    }, 10);
                }
            }

            // Reinitialize Bootstrap dropdowns after any swap
            var dropdowns = document.querySelectorAll('[data-bs-toggle="dropdown"]');
            dropdowns.forEach(function (dropdown) {
                var instance = bootstrap.Dropdown.getInstance(dropdown);
                if (instance) {
                    instance.dispose();
                }
                new bootstrap.Dropdown(dropdown);
            });
        });

        document.addEventListener('htmx:afterSettle', function (evt) {
            var dropdowns = document.querySelectorAll('[data-bs-toggle="dropdown"]');
            dropdowns.forEach(function (dropdown) {
                var instance = bootstrap.Dropdown.getInstance(dropdown);
                if (instance) {
                    instance.dispose();
                }
                new bootstrap.Dropdown(dropdown);
            });
        });

        // Hide search results when clicking outside
        document.addEventListener('click', function (e) {
            var searchContainer = document.querySelector('.search-container');
            var searchResults = document.getElementById('search-results');
            if (searchContainer && !searchContainer.contains(e.target)) {
                searchResults.innerHTML = '';
            }
        });

        window.addEventListener('beforeunload', function() {
            cleanupModals();
        });
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
