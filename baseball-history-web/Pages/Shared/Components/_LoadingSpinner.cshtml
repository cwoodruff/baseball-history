@* Loading Spinner Component
   Usage: @await Html.PartialAsync("Components/_LoadingSpinner")
   Or with custom message: @await Html.PartialAsync("Components/_LoadingSpinner", "Loading players...")
*@

@model string?

<div class="loading-baseball" role="status" aria-live="polite">
    <div class="loading-baseball-icon" aria-hidden="true">&#9918;</div>
    <div class="loading-baseball-text">
        @if (!string.IsNullOrWhiteSpace(Model))
        {
            @Model
        }
        else
        {
            @:Loading...
        }
    </div>
    <span class="visually-hidden">Loading</span>
</div>
