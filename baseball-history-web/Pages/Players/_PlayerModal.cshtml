@model baseball_history_web.ViewModels.PlayerDetailViewModel

@{
    var primaryTeamId = Model.Teams.FirstOrDefault()?.TeamId ?? "";
}

<div class="modal fade modal-baseball" id="playerModal" tabindex="-1" aria-labelledby="playerModalLabel"
     aria-hidden="true"
     data-team="@primaryTeamId">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="playerModalLabel">
                    @Model.FullName
                    @if (Model.IsInHallOfFame)
                    {
                        <span class="hof-badge ms-2">HOF @Model.HofInductionYear</span>
                    }
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @await Html.PartialAsync("_PlayerModalOverview", Model)

                    <div class="col-lg-8">
                        @await Html.PartialAsync("_PlayerCareerSummary", Model)

                        @if (Model.IsTwoWayPlayer)
                        {
                            <ul class="nav nav-tabs mb-2" id="seasonsTabs-@Model.PlayerId" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="batting-tab-@Model.PlayerId" data-bs-toggle="tab"
                                            data-bs-target="#batting-@Model.PlayerId" type="button" role="tab"
                                            aria-controls="batting-@Model.PlayerId" aria-selected="true">
                                        Batting
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="pitching-tab-@Model.PlayerId" data-bs-toggle="tab"
                                            data-bs-target="#pitching-@Model.PlayerId" type="button" role="tab"
                                            aria-controls="pitching-@Model.PlayerId" aria-selected="false">
                                        Pitching
                                    </button>
                                </li>
                            </ul>
                            <div class="tab-content" id="seasonsTabContent-@Model.PlayerId">
                                <div class="tab-pane fade show active" id="batting-@Model.PlayerId" role="tabpanel"
                                     aria-labelledby="batting-tab-@Model.PlayerId">
                                    @await Html.PartialAsync("_PlayerBattingSeasonsTable", Model)
                                </div>
                                <div class="tab-pane fade" id="pitching-@Model.PlayerId" role="tabpanel"
                                     aria-labelledby="pitching-tab-@Model.PlayerId">
                                    @await Html.PartialAsync("_PlayerPitchingSeasonsTable", Model)
                                </div>
                            </div>
                        }
                        else if (Model.IsPitcher && Model.PitchingSeasons.Any())
                        {
                            @await Html.PartialAsync("_PlayerPitchingSeasonsTable", Model)
                        }
                        else if (Model.BattingSeasons.Any())
                        {
                            @await Html.PartialAsync("_PlayerBattingSeasonsTable", Model)
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
