@model baseball_history_web.ViewModels.PlayerDetailViewModel

@{
    var primaryTeamId = Model.Teams.FirstOrDefault()?.TeamId ?? "";
}

<div class="modal fade modal-baseball" id="playerModal" tabindex="-1" aria-labelledby="playerModalLabel"
     aria-hidden="true"
     data-team="@primaryTeamId">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="playerModalLabel">
                    @Model.FullName
                    @if (Model.IsPartialRecord)
                    {
                        @await Html.PartialAsync("Components/_PartialRecordBadge", false)
                    }
                    @if (Model.IsInHallOfFame)
                    {
                        <a class="hof-badge ms-2 text-decoration-none"
                           href="/HallOfFame?year=@Model.HofInductionYear"
                           title="View the @Model.HofInductionYear Hall of Fame class">
                            HOF @Model.HofInductionYear
                        </a>
                    }
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @await Html.PartialAsync("_PlayerModalOverview", Model)

                    <div class="col-lg-8">
                        @await Html.PartialAsync("_PlayerCareerSummary", Model)

                        @await Html.PartialAsync("_PlayerStatsTabs", Model)
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-primary" href="/Players/@Model.PlayerId">View Full Page</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
