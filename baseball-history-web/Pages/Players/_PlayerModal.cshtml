@model baseball_history_web.ViewModels.PlayerDetailViewModel

@{
    var primaryTeamId = Model.Teams.FirstOrDefault()?.TeamId ?? "";
}

<div class="modal fade modal-baseball" id="playerModal" tabindex="-1" aria-labelledby="playerModalLabel"
     aria-hidden="true"
     data-team="@primaryTeamId">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="playerModalLabel">
                    @Model.FullName
                    @if (Model.IsInHallOfFame)
                    {
                        <span class="hof-badge ms-2">HOF @Model.HofInductionYear</span>
                    }
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Left column: Bio -->
                    <div class="col-lg-4 mb-4">
                        <div class="card">
                            <div class="card-header card-header-mlb">
                                <strong>Player Info</strong>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0">
                                    @if (!string.IsNullOrEmpty(Model.GivenName))
                                    {
                                        <dt class="col-sm-4">Full Name</dt>
                                        <dd class="col-sm-8">@Model.GivenName</dd>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BirthDate))
                                    {
                                        <dt class="col-sm-4">Born</dt>
                                        <dd class="col-sm-8">
                                            @Model.BirthDate
                                            @if (!string.IsNullOrEmpty(Model.BirthPlace))
                                            {
                                                <br/>
                                                <small class="text-muted">@Model.BirthPlace</small>
                                            }
                                        </dd>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.DeathDate))
                                    {
                                        <dt class="col-sm-4">Died</dt>
                                        <dd class="col-sm-8">@Model.DeathDate</dd>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Height) || !string.IsNullOrEmpty(Model.Weight))
                                    {
                                        <dt class="col-sm-4">Size</dt>
                                        <dd class="col-sm-8">
                                            @if (!string.IsNullOrEmpty(Model.Height))
                                            {
                                                var inches = int.TryParse(Model.Height, out var h) ? h : 0;
                                                var feet = inches / 12;
                                                var remainingInches = inches % 12;
                                                <span>@feet'@remainingInches"</span>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.Weight))
                                            {
                                                <span> / @Model.Weight lbs</span>
                                            }
                                        </dd>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Bats) || !string.IsNullOrEmpty(Model.Throws))
                                    {
                                        <dt class="col-sm-4">B/T</dt>
                                        <dd class="col-sm-8">@Model.Bats / @Model.Throws</dd>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Debut))
                                    {
                                        <dt class="col-sm-4">Debut</dt>
                                        <dd class="col-sm-8">@Model.Debut</dd>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.FinalGame))
                                    {
                                        <dt class="col-sm-4">Final Game</dt>
                                        <dd class="col-sm-8">@Model.FinalGame</dd>
                                    }
                                    @if (Model.CareerYears.HasValue)
                                    {
                                        <dt class="col-sm-4">Career</dt>
                                        <dd class="col-sm-8">@Model.CareerYears years</dd>
                                    }
                                </dl>
                            </div>
                        </div>

                        @if (Model.Teams.Any())
                        {
                            <div class="card mt-3">
                                <div class="card-header card-header-mlb">
                                    <strong>Teams</strong>
                                </div>
                                <ul class="list-group list-group-flush">
                                    @foreach (var team in Model.Teams)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center"
                                            data-team="@team.TeamId">
                                            <span>@(team.TeamName ?? team.TeamId)</span>
                                            <small class="text-muted">@team.FirstYear-@team.LastYear</small>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.Awards.Any() || Model.AllStarAppearances.Any())
                        {
                            <div class="card mt-3">
                                <div class="card-header card-header-mlb">
                                    <strong>Honors</strong>
                                </div>
                                <div class="card-body">
                                    @if (Model.AllStarAppearances.Any())
                                    {
                                        <div class="mb-2">
                                            <span class="stat-badge stat-badge-primary">
                                                @Model.AllStarAppearances.Count x All-Star
                                            </span>
                                        </div>
                                    }
                                    @foreach (var award in Model.Awards.Take(10))
                                    {
                                        <div class="small mb-1">
                                            <strong>@award.Year</strong> - @award.AwardId (@award.LgId)
                                        </div>
                                    }
                                    @if (Model.Awards.Count > 10)
                                    {
                                        <small class="text-muted">... and @(Model.Awards.Count - 10) more</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Right column: Stats -->
                    <div class="col-lg-8">
                        @if (Model.BattingStats != null)
                        {
                            <div class="card mb-4">
                                <div class="card-header card-header-mlb">
                                    <strong>Career Batting</strong>
                                </div>
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col">
                                            <div
                                                class="h4 mb-0 text-mlb-navy">@Model.BattingStats.Games.ToString("N0")</div>
                                            <small class="text-muted">G</small>
                                        </div>
                                        <div class="col">
                                            <div class="h4 mb-0 text-mlb-navy">@Model.BattingStats.FormattedAvg</div>
                                            <small class="text-muted">AVG</small>
                                        </div>
                                        <div class="col">
                                            <div
                                                class="h4 mb-0 text-mlb-navy">@Model.BattingStats.Hits.ToString("N0")</div>
                                            <small class="text-muted">H</small>
                                        </div>
                                        <div class="col">
                                            <div
                                                class="h4 mb-0 text-mlb-navy">@Model.BattingStats.HomeRuns.ToString("N0")</div>
                                            <small class="text-muted">HR</small>
                                        </div>
                                        <div class="col">
                                            <div
                                                class="h4 mb-0 text-mlb-navy">@Model.BattingStats.Rbi.ToString("N0")</div>
                                            <small class="text-muted">RBI</small>
                                        </div>
                                        <div class="col">
                                            <div class="h4 mb-0 text-mlb-navy">@Model.BattingStats.FormattedOps</div>
                                            <small class="text-muted">OPS</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Model.PitchingStats != null && Model.PitchingStats.InningsPitched > 0)
                        {
                            <div class="card mb-4">
                                <div class="card-header card-header-mlb">
                                    <strong>Career Pitching</strong>
                                </div>
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col">
                                            <div class="h4 mb-0 text-mlb-navy">@Model.PitchingStats.WinLossRecord</div>
                                            <small class="text-muted">W-L</small>
                                        </div>
                                        <div class="col">
                                            <div class="h4 mb-0 text-mlb-navy">@Model.PitchingStats.FormattedEra</div>
                                            <small class="text-muted">ERA</small>
                                        </div>
                                        <div class="col">
                                            <div
                                                class="h4 mb-0 text-mlb-navy">@Model.PitchingStats.Games.ToString("N0")</div>
                                            <small class="text-muted">G</small>
                                        </div>
                                        <div class="col">
                                            <div
                                                class="h4 mb-0 text-mlb-navy">@Model.PitchingStats.Strikeouts.ToString("N0")</div>
                                            <small class="text-muted">SO</small>
                                        </div>
                                        <div class="col">
                                            <div
                                                class="h4 mb-0 text-mlb-navy">@Model.PitchingStats.Saves.ToString("N0")</div>
                                            <small class="text-muted">SV</small>
                                        </div>
                                        <div class="col">
                                            <div class="h4 mb-0 text-mlb-navy">@Model.PitchingStats.FormattedWhip</div>
                                            <small class="text-muted">WHIP</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Model.BattingSeasons.Any())
                        {
                            <div class="card">
                                <div class="card-header card-header-mlb">
                                    <strong>Season by Season</strong>
                                </div>
                                <div class="table-responsive" style="max-height: 400px;">
                                    <table class="table table-sm table-baseball mb-0">
                                        <thead>
                                        <tr>
                                            <th>Year</th>
                                            <th>Team</th>
                                            <th class="text-end">G</th>
                                            <th class="text-end">AB</th>
                                            <th class="text-end">H</th>
                                            <th class="text-end">2B</th>
                                            <th class="text-end">3B</th>
                                            <th class="text-end">HR</th>
                                            <th class="text-end">R</th>
                                            <th class="text-end">AVG</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var season in Model.BattingSeasons)
                                        {
                                            <tr data-team="@season.TeamId">
                                                <td>@season.Year</td>
                                                <td>@(season.TeamName ?? season.TeamId)</td>
                                                <td class="text-end stat-cell">@season.Games</td>
                                                <td class="text-end stat-cell">@season.AtBats</td>
                                                <td class="text-end stat-cell">@season.Hits</td>
                                                <td class="text-end stat-cell">@season.Doubles</td>
                                                <td class="text-end stat-cell">@season.Triples</td>
                                                <td class="text-end stat-cell">@season.HomeRuns</td>
                                                <td class="text-end stat-cell">@season.Runs</td>
                                                <td class="text-end stat-cell">@season.FormattedAvg</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
