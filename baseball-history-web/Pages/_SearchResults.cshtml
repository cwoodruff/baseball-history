@model baseball_history_web.ViewModels.SearchViewModel

@if (!Model.HasResults)
{
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <div class="search-result-item text-center py-3">
            <div class="text-muted">No results found for "@Model.Query"</div>
            <small class="text-muted d-block mb-2">Check the spelling or try just a last name.</small>
            <small class="text-muted fw-bold d-block mb-2">POPULAR PLAYERS</small>
            <div class="d-flex flex-wrap justify-content-center gap-2 px-3">
                @foreach (var (id, name) in new[] { ("ruthba01", "Babe Ruth"), ("aaronha01", "Hank Aaron"), ("mayswi01", "Willie Mays"), ("jeterde01", "Derek Jeter"), ("ohtansh01", "Shohei Ohtani") })
                {
                    <a href="/Players/@id" class="btn btn-sm btn-outline-primary rounded-pill"
                       onclick="document.getElementById('search-results').innerHTML = '';">
                        @name
                    </a>
                }
            </div>
            <div class="pt-2">
                <a href="/Players" class="small text-decoration-none"
                   onclick="document.getElementById('search-results').innerHTML = '';">
                    Browse all players
                </a>
            </div>
        </div>
    }
}
else
{
    @if (Model.Players.Any())
    {
        <div class="px-3 py-2 bg-light border-bottom">
            <small class="text-muted fw-bold">PLAYERS</small>
        </div>
        @foreach (var player in Model.Players)
        {
            @await Html.PartialAsync("Components/_SearchResultLink", new baseball_history_web.ViewModels.SearchResultLinkModel
            {
                Result = player,
                ItemClass = "search-result-item text-decoration-none",
                IconClass = "result-icon",
                ClearSearchResultsOnClick = true
            })
        }
    }

    @if (Model.Teams.Any())
    {
        <div class="px-3 py-2 bg-light border-bottom">
            <small class="text-muted fw-bold">TEAMS</small>
        </div>
        @foreach (var team in Model.Teams)
        {
            @await Html.PartialAsync("Components/_SearchResultLink", new baseball_history_web.ViewModels.SearchResultLinkModel
            {
                Result = team,
                ItemClass = "search-result-item text-decoration-none",
                IconClass = "result-icon bg-team-gradient",
                ClearSearchResultsOnClick = true
            })
        }
    }

    <div class="px-3 py-2 text-center border-top">
        <button type="button" class="btn btn-link btn-sm small text-decoration-none p-0"
                hx-get="/Search?handler=AllResults&q=@Uri.EscapeDataString(Model.Query)"
                hx-target="#modal-container"
                hx-swap="innerHTML"
                hx-boost="false"
                onclick="setTimeout(function() { document.getElementById('search-results').innerHTML = ''; }, 0);">
            View all results for "@Model.Query"
        </button>
    </div>
}
