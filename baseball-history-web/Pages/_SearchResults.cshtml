@model baseball_history_web.ViewModels.SearchViewModel

@if (!Model.HasResults)
{
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <div class="search-result-item text-center text-muted py-3">
            No results found for "@Model.Query"
        </div>
    }
}
else
{
    @if (Model.Players.Any())
    {
        <div class="px-3 py-2 bg-light border-bottom">
            <small class="text-muted fw-bold">PLAYERS</small>
        </div>
        @foreach (var player in Model.Players)
        {
            @await Html.PartialAsync("Components/_SearchResultLink", new baseball_history_web.ViewModels.SearchResultLinkModel
            {
                Result = player,
                ItemClass = "search-result-item text-decoration-none",
                IconClass = "result-icon",
                ClearSearchResultsOnClick = true
            })
        }
    }

    @if (Model.Teams.Any())
    {
        <div class="px-3 py-2 bg-light border-bottom">
            <small class="text-muted fw-bold">TEAMS</small>
        </div>
        @foreach (var team in Model.Teams)
        {
            @await Html.PartialAsync("Components/_SearchResultLink", new baseball_history_web.ViewModels.SearchResultLinkModel
            {
                Result = team,
                ItemClass = "search-result-item text-decoration-none",
                IconClass = "result-icon bg-team-gradient",
                ClearSearchResultsOnClick = true
            })
        }
    }

    <div class="px-3 py-2 text-center border-top">
        <a href="#" class="small text-decoration-none"
           hx-get="/Search?handler=AllResults&q=@Uri.EscapeDataString(Model.Query)"
           hx-target="#modal-container"
           hx-swap="innerHTML"
           hx-boost="false"
           onclick="setTimeout(function() { document.getElementById('search-results').innerHTML = ''; }, 0);">
            View all results for "@Model.Query"
        </a>
    </div>
}
