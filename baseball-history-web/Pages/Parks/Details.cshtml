@page "/Parks/{parkKey}"
@using baseball_history_web.ViewModels
@model baseball_history_web.Pages.Parks.DetailsModel
@{
    ViewData["Title"] = Model.Park.ParkName ?? "Ballpark";
}

@await Html.PartialAsync("Components/_Breadcrumbs", BreadcrumbModel.Build(
    new BreadcrumbItem("Ballparks", "/Parks"),
    new BreadcrumbItem(Model.Park.ParkName ?? Model.Park.ParkKey)))

<div id="park-content">
    @await Html.PartialAsync("_ParkDetail", Model.Park)
</div>
