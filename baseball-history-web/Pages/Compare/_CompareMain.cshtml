@model baseball_history_web.ViewModels.CompareViewModel
@{
    var players = new[] { Model.Player1, Model.Player2, Model.Player3, Model.Player4 };
    var playerIds = players.Select(p => p?.PlayerId ?? "").ToArray();
    
    // Gradient colors for each slot
    var gradients = new[]
    {
        "135deg, #1a2744 0%, #2c3e6b 100%",  // Navy (player 1)
        "135deg, #8b1a2b 0%, #c62d42 100%",  // Red (player 2)
        "135deg, #1a5f3d 0%, #2d8b5e 100%",  // Green (player 3)
        "135deg, #8b6f1a 0%, #c6a12d 100%"   // Gold/Amber (player 4)
    };
    
    // Show selected count + 1 slots (capped at 4, minimum 2)
    var visibleSlots = Math.Max(2, Math.Min(Model.SelectedCount + 1, 4));
}

@await Html.PartialAsync("_CompareHeader", Model)

<!-- Player selection cards (responsive 2x2 grid on medium+, single column on mobile) -->
<div class="row mb-4">
    @for (int i = 0; i < visibleSlots; i++)
    {
        var side = i + 1;
        var player = players[i];
        var otherPlayerIds = playerIds.Where((id, idx) => idx != i && !string.IsNullOrEmpty(id)).ToArray();
        var otherPlayerIdsCombined = string.Join(",", otherPlayerIds);
        
        <div class="col-md-6 col-lg-@(visibleSlots <= 2 ? 6 : 3) mb-3">
            @await Html.PartialAsync("_ComparePlayerCard", (player, side, otherPlayerIdsCombined, gradients[i]))
        </div>
    }
</div>

<!-- Comparison tables and chart (only shown when 2+ selected) -->
@if (Model.BothSelected)
{
    <div id="compare-tables">
        @await Html.PartialAsync("_CompareContent", Model)
    </div>
}
