@using baseball_history_web.ViewModels
@using System.Text.Json
@model CompareViewModel

@if (Model.BothSelected)
{
    var players = Model.SelectedPlayers;
    var fromYear = ViewContext.HttpContext.Request.Query["fromYear"].ToString();
    var toYear = ViewContext.HttpContext.Request.Query["toYear"].ToString();
    var hasYearRange = !string.IsNullOrEmpty(fromYear) || !string.IsNullOrEmpty(toYear);
    var yearRangeLabel = hasYearRange
        ? $"({(string.IsNullOrEmpty(fromYear) ? "All" : fromYear)}-{(string.IsNullOrEmpty(toYear) ? "Present" : toYear)})"
        : "";
    
    var playerNames = players.Select(p => p.FullName).ToList();

    <h3 class="text-center text-mlb-navy mb-4">
        @Html.Raw(string.Join(" <span class='text-muted mx-2'>vs</span> ", playerNames))
    </h3>

    @* Comparison Chart *@
    @if (Model.HasBatters || Model.HasPitchers)
    {
        // Prepare chart data: normalized comparison across all players
        var chartLabels = new List<string>();
        var chartDatasets = new List<object>();
        var chartColors = new[] { "#2c3e6b", "#c62d42", "#2d8b5e", "#c6a12d" };
        
        // Build batting chart data
        if (Model.HasBatters)
        {
            chartLabels.AddRange(new[] { "AVG", "OBP", "SLG", "HR Rate", "RBI Rate" });
        }
        
        // Build pitching chart data
        if (Model.HasPitchers)
        {
            chartLabels.AddRange(new[] { "ERA (inv)", "WHIP (inv)", "K/9", "W%" });
        }
        
        for (int i = 0; i < players.Count; i++)
        {
            var player = players[i];
            var dataPoints = new List<double?>();
            
            if (Model.HasBatters)
            {
                var stats = player.BattingStats;
                if (stats != null)
                {
                    dataPoints.Add(stats.BattingAverage);
                    dataPoints.Add(stats.OnBasePercentage);
                    dataPoints.Add(stats.SluggingPercentage);
                    dataPoints.Add(stats.AtBats > 0 ? stats.HomeRuns / (double)stats.AtBats * 100 : 0);
                    dataPoints.Add(stats.AtBats > 0 ? stats.Rbi / (double)stats.AtBats * 100 : 0);
                }
                else
                {
                    dataPoints.AddRange(new double?[] { null, null, null, null, null });
                }
            }
            
            if (Model.HasPitchers)
            {
                var stats = player.PitchingStats;
                if (stats != null)
                {
                    // Invert ERA and WHIP (lower is better, so show inverted for visual consistency)
                    dataPoints.Add(stats.Era > 0 ? 10 - Math.Min(stats.Era, 10) : 0);
                    dataPoints.Add(stats.Whip > 0 ? 3 - Math.Min(stats.Whip, 3) : 0);
                    dataPoints.Add(stats.InningsPitched > 0 ? stats.Strikeouts / stats.InningsPitched * 9 : 0);
                    var totalGames = stats.Wins + stats.Losses;
                    dataPoints.Add(totalGames > 0 ? stats.Wins / (double)totalGames * 100 : 0);
                }
                else
                {
                    dataPoints.AddRange(new double?[] { null, null, null, null });
                }
            }
            
            chartDatasets.Add(new
            {
                label = player.FullName,
                data = dataPoints,
                borderColor = chartColors[i],
                backgroundColor = chartColors[i] + "33",
                borderWidth = 2
            });
        }
        
        var chartData = new
        {
            labels = chartLabels,
            datasets = chartDatasets
        };
        
        var chartDataJson = JsonSerializer.Serialize(chartData);
        var playerNamesJson = JsonSerializer.Serialize(playerNames);
        
        <div class="card mb-4">
            <div class="card-header card-header-mlb">
                <strong>Visual Comparison</strong>
            </div>
            <div class="card-body">
                <canvas id="comparison-chart" style="max-height: 400px;"></canvas>
            </div>
        </div>
        
        <script>
            (function() {
                window.comparePlayerNames = @Html.Raw(playerNamesJson);
                window.compareChartData = @Html.Raw(chartDataJson);
                
                // Destroy existing chart if present (for htmx swaps)
                if (window.comparisonChartInstance) {
                    window.comparisonChartInstance.destroy();
                }
                
                // Initialize Chart.js if available
                if (typeof Chart !== 'undefined') {
                    var ctx = document.getElementById('comparison-chart');
                    if (ctx) {
                        window.comparisonChartInstance = new Chart(ctx, {
                            type: 'bar',
                            data: window.compareChartData,
                            options: {
                                responsive: true,
                                maintainAspectRatio: true,
                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                },
                                plugins: {
                                    legend: {
                                        position: 'top'
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                var label = context.dataset.label || '';
                                                if (label) {
                                                    label += ': ';
                                                }
                                                if (context.parsed.y !== null) {
                                                    label += context.parsed.y.toFixed(3);
                                                }
                                                return label;
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    }
                }
            })();
        </script>
    }

    @* Awards & Honors Table *@
    <div class="card mb-4">
        <div class="card-header card-header-mlb">
            <strong>Awards &amp; Honors</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-baseball mb-0">
                <thead>
                <tr>
                    <th class="text-center" style="width: @(100 / (players.Count + 1))%;">Category</th>
                    @foreach (var player in players)
                    {
                        <th class="text-center" style="width: @(100 / (players.Count + 1))%;">@player.FullName</th>
                    }
                </tr>
                </thead>
                <tbody>
                @{
                    var awardRows = new (string Label, Func<ComparePlayer, int> Getter)[]
                    {
                        ("All-Star Selections", p => p.AllStarCount),
                        ("MVP Awards", p => p.MvpCount),
                        ("Gold Gloves", p => p.GoldGloveCount),
                        ("Silver Sluggers", p => p.SilverSluggerCount),
                        ("Total Awards", p => p.AwardCount)
                    };
                }
                @foreach (var row in awardRows)
                {
                    var values = players.Select(p => row.Getter(p)).ToList();
                    var maxVal = values.Max();
                    <tr>
                        <td class="text-center text-muted small">@row.Label</td>
                        @foreach (var val in values)
                        {
                            <td class="text-center stat-cell fw-bold @(val == maxVal && val > 0 ? "text-success" : "")">
                                @(val == maxVal && val > 0 ? "▲ " : "")@val
                            </td>
                        }
                    </tr>
                }
                <tr>
                    <td class="text-center text-muted small">Hall of Fame</td>
                    @foreach (var player in players)
                    {
                        <td class="text-center">
                            @if (player.IsInHallOfFame) { <span class="hof-badge">HOF</span> } else { <span class="text-muted">&mdash;</span> }
                        </td>
                    }
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* Batting Comparison *@
    @if (Model.HasBatters)
    {
        <div class="card mb-4">
            <div class="card-header card-header-mlb">
                <strong>@(hasYearRange ? $"Batting {yearRangeLabel}" : "Career Batting")</strong>
                @if (!hasYearRange)
                {
                    <span class="float-end small text-muted">
                        @foreach (var player in players.Where(p => p.TotalBattingSeasons > 0))
                        {
                            <span class="me-3">@player.FullName: @player.QualifiedBattingSeasons of @player.TotalBattingSeasons qualified</span>
                        }
                    </span>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-baseball mb-0">
                    <thead>
                    <tr>
                        <th class="text-center" style="width: @(100 / (players.Count + 1))%;">Stat</th>
                        @foreach (var player in players)
                        {
                            <th class="text-center" style="width: @(100 / (players.Count + 1))%;">@player.FullName</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        var battingRows = new (string Label, Func<CompareCareerBattingStats, string> Fmt, Func<CompareCareerBattingStats, double> Val, bool LowerBetter)[]
                        {
                            ("Games", s => s.Games.ToString("N0"), s => s.Games, false),
                            ("At Bats", s => s.AtBats.ToString("N0"), s => s.AtBats, false),
                            ("Runs", s => s.Runs.ToString("N0"), s => s.Runs, false),
                            ("Hits", s => s.Hits.ToString("N0"), s => s.Hits, false),
                            ("Doubles", s => s.Doubles.ToString("N0"), s => s.Doubles, false),
                            ("Triples", s => s.Triples.ToString("N0"), s => s.Triples, false),
                            ("Home Runs", s => s.HomeRuns.ToString("N0"), s => s.HomeRuns, false),
                            ("RBI", s => s.Rbi.ToString("N0"), s => s.Rbi, false),
                            ("Stolen Bases", s => s.StolenBases.ToString("N0"), s => s.StolenBases, false),
                            ("Walks", s => s.Walks.ToString("N0"), s => s.Walks, false),
                            ("Strikeouts", s => s.Strikeouts.ToString("N0"), s => s.Strikeouts, true),
                            ("AVG", s => s.FormattedAvg, s => s.BattingAverage, false),
                            ("OBP", s => s.FormattedObp, s => s.OnBasePercentage, false),
                            ("SLG", s => s.FormattedSlg, s => s.SluggingPercentage, false),
                            ("OPS", s => s.FormattedOps, s => s.Ops, false)
                        };
                    }
                    @foreach (var row in battingRows)
                    {
                        var stats = players.Select(p => p.BattingStats).ToList();
                        var values = stats.Select(s => s != null ? row.Val(s) : 0).ToList();
                        var bestVal = row.LowerBetter
                            ? values.Where(v => v > 0).DefaultIfEmpty(0).Min()
                            : values.Max();
                        <tr>
                            <td class="text-center text-muted small">@row.Label</td>
                            @for (int i = 0; i < players.Count; i++)
                            {
                                var stat = stats[i];
                                var val = values[i];
                                var isBest = stat != null && ((row.LowerBetter && val == bestVal && val > 0) || (!row.LowerBetter && val == bestVal && val > 0));
                                <td class="text-center stat-cell fw-bold @(isBest ? "text-success" : "")">
                                    @if (isBest) { <text>▲ </text> }@(stat != null ? row.Fmt(stat) : "—")
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Pitching Comparison *@
    @if (Model.HasPitchers)
    {
        <div class="card mb-4">
            <div class="card-header card-header-mlb">
                <strong>@(hasYearRange ? $"Pitching {yearRangeLabel}" : "Career Pitching")</strong>
                @if (!hasYearRange)
                {
                    <span class="float-end small text-muted">
                        @foreach (var player in players.Where(p => p.TotalPitchingSeasons > 0))
                        {
                            <span class="me-3">@player.FullName: @player.QualifiedPitchingSeasons of @player.TotalPitchingSeasons qualified</span>
                        }
                    </span>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-baseball mb-0">
                    <thead>
                    <tr>
                        <th class="text-center" style="width: @(100 / (players.Count + 1))%;">Stat</th>
                        @foreach (var player in players)
                        {
                            <th class="text-center" style="width: @(100 / (players.Count + 1))%;">@player.FullName</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        var pitchingRows = new (string Label, Func<CompareCareerPitchingStats, string> Fmt, Func<CompareCareerPitchingStats, double> Val, bool LowerBetter)[]
                        {
                            ("W-L Record", s => s.WinLossRecord, s => s.Wins, false),
                            ("Games", s => s.Games.ToString("N0"), s => s.Games, false),
                            ("Games Started", s => s.GamesStarted.ToString("N0"), s => s.GamesStarted, false),
                            ("Saves", s => s.Saves.ToString("N0"), s => s.Saves, false),
                            ("Complete Games", s => s.CompleteGames.ToString("N0"), s => s.CompleteGames, false),
                            ("Shutouts", s => s.Shutouts.ToString("N0"), s => s.Shutouts, false),
                            ("Innings Pitched", s => s.InningsPitched.ToString("N1"), s => s.InningsPitched, false),
                            ("Strikeouts", s => s.Strikeouts.ToString("N0"), s => s.Strikeouts, false),
                            ("Walks", s => s.Walks.ToString("N0"), s => s.Walks, true),
                            ("ERA", s => s.FormattedEra, s => s.Era, true),
                            ("WHIP", s => s.FormattedWhip, s => s.Whip, true)
                        };
                    }
                    @foreach (var row in pitchingRows)
                    {
                        var stats = players.Select(p => p.PitchingStats).ToList();
                        var values = stats.Select(s => s != null ? row.Val(s) : 0).ToList();
                        var bestVal = row.LowerBetter
                            ? values.Where(v => v > 0).DefaultIfEmpty(0).Min()
                            : values.Max();
                        <tr>
                            <td class="text-center text-muted small">@row.Label</td>
                            @for (int i = 0; i < players.Count; i++)
                            {
                                var stat = stats[i];
                                var val = values[i];
                                var isBest = stat != null && ((row.LowerBetter && val == bestVal && val > 0) || (!row.LowerBetter && val == bestVal && val > 0));
                                <td class="text-center stat-cell fw-bold @(isBest ? "text-success" : "")">
                                    @if (isBest) { <text>▲ </text> }@(stat != null ? row.Fmt(stat) : "—")
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Postseason Batting *@
    @if (Model.HasPostseasonBatting)
    {
        <div class="card mb-4">
            <div class="card-header card-header-mlb">
                <strong>Postseason Batting</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-baseball mb-0">
                    <thead>
                    <tr>
                        <th class="text-center" style="width: @(100 / (players.Count + 1))%;">Stat</th>
                        @foreach (var player in players)
                        {
                            <th class="text-center" style="width: @(100 / (players.Count + 1))%;">@player.FullName</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        var postseasonBattingRows = new (string Label, Func<ComparePostseasonBattingStats, string> Fmt, Func<ComparePostseasonBattingStats, double> Val)[]
                        {
                            ("Games", s => s.Games.ToString("N0"), s => s.Games),
                            ("At Bats", s => s.AtBats.ToString("N0"), s => s.AtBats),
                            ("Hits", s => s.Hits.ToString("N0"), s => s.Hits),
                            ("Home Runs", s => s.HomeRuns.ToString("N0"), s => s.HomeRuns),
                            ("RBI", s => s.Rbi.ToString("N0"), s => s.Rbi),
                            ("AVG", s => s.FormattedAvg, s => s.BattingAverage)
                        };
                    }
                    @foreach (var row in postseasonBattingRows)
                    {
                        var stats = players.Select(p => p.PostseasonBattingStats).ToList();
                        var values = stats.Select(s => s != null ? row.Val(s) : 0).ToList();
                        var bestVal = values.Max();
                        <tr>
                            <td class="text-center text-muted small">@row.Label</td>
                            @for (int i = 0; i < players.Count; i++)
                            {
                                var stat = stats[i];
                                var val = values[i];
                                var isBest = stat != null && val == bestVal && val > 0;
                                <td class="text-center stat-cell fw-bold @(isBest ? "text-success" : "")">
                                    @if (isBest) { <text>▲ </text> }@(stat != null ? row.Fmt(stat) : "—")
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Postseason Pitching *@
    @if (Model.HasPostseasonPitching)
    {
        <div class="card mb-4">
            <div class="card-header card-header-mlb">
                <strong>Postseason Pitching</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-baseball mb-0">
                    <thead>
                    <tr>
                        <th class="text-center" style="width: @(100 / (players.Count + 1))%;">Stat</th>
                        @foreach (var player in players)
                        {
                            <th class="text-center" style="width: @(100 / (players.Count + 1))%;">@player.FullName</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        var postseasonPitchingRows = new (string Label, Func<ComparePostseasonPitchingStats, string> Fmt, Func<ComparePostseasonPitchingStats, double> Val, bool LowerBetter)[]
                        {
                            ("Games", s => s.Games.ToString("N0"), s => s.Games, false),
                            ("Wins", s => s.Wins.ToString("N0"), s => s.Wins, false),
                            ("Losses", s => s.Losses.ToString("N0"), s => s.Losses, true),
                            ("Saves", s => s.Saves.ToString("N0"), s => s.Saves, false),
                            ("Innings Pitched", s => s.InningsPitched.ToString("N1"), s => s.InningsPitched, false),
                            ("Strikeouts", s => s.Strikeouts.ToString("N0"), s => s.Strikeouts, false),
                            ("ERA", s => s.FormattedEra, s => s.Era, true)
                        };
                    }
                    @foreach (var row in postseasonPitchingRows)
                    {
                        var stats = players.Select(p => p.PostseasonPitchingStats).ToList();
                        var values = stats.Select(s => s != null ? row.Val(s) : 0).ToList();
                        var bestVal = row.LowerBetter
                            ? values.Where(v => v > 0).DefaultIfEmpty(0).Min()
                            : values.Max();
                        <tr>
                            <td class="text-center text-muted small">@row.Label</td>
                            @for (int i = 0; i < players.Count; i++)
                            {
                                var stat = stats[i];
                                var val = values[i];
                                var isBest = stat != null && ((row.LowerBetter && val == bestVal && val > 0) || (!row.LowerBetter && val == bestVal && val > 0));
                                <td class="text-center stat-cell fw-bold @(isBest ? "text-success" : "")">
                                    @if (isBest) { <text>▲ </text> }@(stat != null ? row.Fmt(stat) : "—")
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Fielding (no cross-player highlighting as positions differ) *@
    @if (Model.HasFielding)
    {
        <div class="card mb-4">
            <div class="card-header card-header-mlb">
                <strong>Fielding</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-baseball mb-0">
                    <thead>
                    <tr>
                        <th class="text-center" style="width: @(100 / (players.Count + 1))%;">Stat</th>
                        @foreach (var player in players)
                        {
                            <th class="text-center" style="width: @(100 / (players.Count + 1))%;">@player.FullName</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        var fieldingRows = new (string Label, Func<CompareFieldingStats, string> Fmt)[]
                        {
                            ("Primary Position", s => s.PrimaryPosition),
                            ("Games", s => s.Games.ToString("N0")),
                            ("Putouts", s => s.Putouts.ToString("N0")),
                            ("Assists", s => s.Assists.ToString("N0")),
                            ("Errors", s => s.Errors.ToString("N0")),
                            ("Fielding %", s => s.FormattedFieldingPercentage),
                            ("Double Plays", s => s.DoublePlays.ToString("N0"))
                        };
                    }
                    @foreach (var row in fieldingRows)
                    {
                        var stats = players.Select(p => p.FieldingStats).ToList();
                        <tr>
                            <td class="text-center text-muted small">@row.Label</td>
                            @for (int i = 0; i < players.Count; i++)
                            {
                                var stat = stats[i];
                                <td class="text-center stat-cell fw-bold">@(stat != null ? row.Fmt(stat) : "—")</td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
