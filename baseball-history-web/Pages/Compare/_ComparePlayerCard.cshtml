@model (baseball_history_web.ViewModels.ComparePlayer? Player, int Side, string? OtherPlayerIds, string Gradient)
@{
    var player = Model.Player;
    var side = Model.Side;
    var otherPlayerIds = Model.OtherPlayerIds ?? "";
    var gradient = Model.Gradient;
    var resultsDivId = $"search-results-{side}";
    var searchSide = side;
}

<div class="card h-100">
    <div class="card-header card-header-mlb text-center">
        <strong>Player @side</strong>
    </div>
    @if (player != null)
    {
        <div class="card-body text-center py-4" style="background: linear-gradient(@gradient);">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                 style="width: 64px; height: 64px; background: rgba(255,255,255,0.15); color: white; font-size: 1.4rem; font-weight: bold;">
                @player.Initials
            </div>
            <h4 class="text-white mb-1">
                <a href="/Players/@player.PlayerId" class="text-white text-decoration-none"
                   hx-get="/Players/Modal/@player.PlayerId"
                   hx-target="#modal-container"
                   hx-swap="innerHTML"
                   hx-boost="false">
                    @player.FullName
                </a>
            </h4>
            @if (player.IsInHallOfFame)
            {
                <div class="mb-1"><span class="hof-badge">HOF @player.HofInductionYear</span></div>
            }
            <div class="text-white-50 small">
                @player.Debut &ndash; @(player.FinalGame ?? "Present")
                @if (player.CareerYears.HasValue) { <span>(@player.CareerYears yrs)</span> }
            </div>
            <div class="text-white-50 small">B/T: @(player.Bats ?? "—")/@(player.Throws ?? "—")</div>
            @if (player.TeamNames.Any())
            {
                <div class="text-white-50 small mt-1" style="font-size: 0.75rem;">
                    @string.Join(", ", player.TeamNames.Take(5))
                    @if (player.TeamNames.Count > 5) { <span>+ @(player.TeamNames.Count - 5) more</span> }
                </div>
            }
        </div>
        <div class="card-footer text-center bg-light">
            @{
                var otherParams = string.IsNullOrEmpty(otherPlayerIds)
                    ? ""
                    : string.Join("&", otherPlayerIds.Split(',')
                        .Select((id, idx) =>
                        {
                            var targetSide = idx + 1;
                            return targetSide >= side ? targetSide + 1 : targetSide;
                        })
                        .Zip(otherPlayerIds.Split(','), (s, id) => $"player{s}={id}"));
                var changeUrl = string.IsNullOrEmpty(otherParams) ? "/Compare" : $"/Compare?{otherParams}";
            }
            <a href="@changeUrl" class="btn btn-sm btn-outline-secondary" hx-boost="false">Change Player</a>
        </div>
    }
    else
    {
        <div class="card-body">
            <div class="position-relative">
                @{
                    var searchParams = new List<string>();
                    for (int i = 1; i <= 4; i++)
                    {
                        if (i == side)
                        {
                            searchParams.Add($"player{i}=");
                        }
                        else if (!string.IsNullOrEmpty(otherPlayerIds))
                        {
                            var otherIdsList = otherPlayerIds.Split(',').Where(id => !string.IsNullOrEmpty(id)).ToList();
                            var targetIdx = i < side ? i - 1 : i - 2;
                            if (targetIdx >= 0 && targetIdx < otherIdsList.Count)
                                searchParams.Add($"player{i}={otherIdsList[targetIdx]}");
                        }
                    }
                    var searchUrl = $"/Compare?handler=Search&side={side}&{string.Join("&", searchParams)}";
                    var searchIndicatorId = $"search-indicator-{side}";
                }
                <div class="position-relative">
                    <input type="search" class="form-control form-control-lg"
                           placeholder="Search for Player @side..."
                           name="q"
                           hx-get="@searchUrl"
                           hx-trigger="input changed delay:300ms, search"
                           hx-target="#@resultsDivId"
                           hx-swap="innerHTML"
                           hx-indicator="#@searchIndicatorId"
                           hx-boost="false"
                           autocomplete="off" />
                    <div id="@searchIndicatorId" class="htmx-indicator position-absolute top-50 end-0 translate-middle-y me-2" style="pointer-events: none;">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Searching...</span>
                        </div>
                    </div>
                </div>
                <div id="@resultsDivId" class="position-absolute w-100" style="z-index: 1050;"></div>
            </div>
            <div class="text-center text-muted mt-4 mb-2">
                <div style="font-size: 3rem; opacity: 0.3;">&#9918;</div>
                <p>Search to select a player</p>
            </div>
        </div>
    }
</div>
