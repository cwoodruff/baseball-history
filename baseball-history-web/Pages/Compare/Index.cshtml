@page
@using baseball_history_web.ViewModels
@model baseball_history_web.Pages.Compare.IndexModel
@{
    ViewData["Title"] = "Compare Players";
    var p1 = Model.ViewModel.Player1;
    var p2 = Model.ViewModel.Player2;
    var p1Id = p1?.PlayerId ?? "";
    var p2Id = p2?.PlayerId ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-mlb-navy mb-0">Compare Players</h1>
    @if (p1 != null || p2 != null)
    {
        <a href="/Compare" class="btn btn-sm btn-outline-secondary" hx-boost="false">Start Over</a>
    }
</div>

<!-- Two side-by-side player selection regions -->
<div class="row mb-4">
    <!-- Player 1 (left side) -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-header card-header-mlb text-center">
                <strong>Player 1</strong>
            </div>
            @if (p1 != null)
            {
                <div class="card-body text-center py-4" style="background: linear-gradient(135deg, #1a2744 0%, #2c3e6b 100%);">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                         style="width: 64px; height: 64px; background: rgba(255,255,255,0.15); color: white; font-size: 1.4rem; font-weight: bold;">
                        @p1.Initials
                    </div>
                    <h4 class="text-white mb-1">
                        <a href="#" class="text-white text-decoration-none"
                           hx-get="/Players/Modal/@p1.PlayerId"
                           hx-target="#modal-container"
                           hx-swap="innerHTML"
                           hx-boost="false">
                            @p1.FullName
                        </a>
                    </h4>
                    @if (p1.IsInHallOfFame)
                    {
                        <div class="mb-1"><span class="hof-badge">HOF @p1.HofInductionYear</span></div>
                    }
                    <div class="text-white-50 small">
                        @p1.Debut &ndash; @(p1.FinalGame ?? "Present")
                        @if (p1.CareerYears.HasValue) { <span>(@p1.CareerYears yrs)</span> }
                    </div>
                    <div class="text-white-50 small">B/T: @(p1.Bats ?? "—")/@(p1.Throws ?? "—")</div>
                    @if (p1.TeamNames.Any())
                    {
                        <div class="text-white-50 small mt-1" style="font-size: 0.75rem;">
                            @string.Join(", ", p1.TeamNames.Take(5))
                            @if (p1.TeamNames.Count > 5) { <span>+ @(p1.TeamNames.Count - 5) more</span> }
                        </div>
                    }
                </div>
                <div class="card-footer text-center bg-light">
                    <a href="/Compare@(p2 != null ? $"?player2={p2Id}" : "")"
                       class="btn btn-sm btn-outline-danger"
                       hx-boost="false">Change Player</a>
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="position-relative">
                        <input type="search" class="form-control form-control-lg"
                               placeholder="Search for Player 1..."
                               name="q"
                               hx-get="/Compare?handler=Search&side=1&player1=@p1Id&player2=@p2Id"
                               hx-trigger="input changed delay:300ms, search"
                               hx-target="#search-results-1"
                               hx-swap="innerHTML"
                               hx-boost="false"
                               autocomplete="off" />
                        <div id="search-results-1" class="position-absolute w-100" style="z-index: 1050;"></div>
                    </div>
                    <div class="text-center text-muted mt-4 mb-2">
                        <div style="font-size: 3rem; opacity: 0.3;">&#9918;</div>
                        <p>Search to select a player</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Player 2 (right side) -->
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-header card-header-mlb text-center">
                <strong>Player 2</strong>
            </div>
            @if (p2 != null)
            {
                <div class="card-body text-center py-4" style="background: linear-gradient(135deg, #8b1a2b 0%, #c62d42 100%);">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                         style="width: 64px; height: 64px; background: rgba(255,255,255,0.15); color: white; font-size: 1.4rem; font-weight: bold;">
                        @p2.Initials
                    </div>
                    <h4 class="text-white mb-1">
                        <a href="#" class="text-white text-decoration-none"
                           hx-get="/Players/Modal/@p2.PlayerId"
                           hx-target="#modal-container"
                           hx-swap="innerHTML"
                           hx-boost="false">
                            @p2.FullName
                        </a>
                    </h4>
                    @if (p2.IsInHallOfFame)
                    {
                        <div class="mb-1"><span class="hof-badge">HOF @p2.HofInductionYear</span></div>
                    }
                    <div class="text-white-50 small">
                        @p2.Debut &ndash; @(p2.FinalGame ?? "Present")
                        @if (p2.CareerYears.HasValue) { <span>(@p2.CareerYears yrs)</span> }
                    </div>
                    <div class="text-white-50 small">B/T: @(p2.Bats ?? "—")/@(p2.Throws ?? "—")</div>
                    @if (p2.TeamNames.Any())
                    {
                        <div class="text-white-50 small mt-1" style="font-size: 0.75rem;">
                            @string.Join(", ", p2.TeamNames.Take(5))
                            @if (p2.TeamNames.Count > 5) { <span>+ @(p2.TeamNames.Count - 5) more</span> }
                        </div>
                    }
                </div>
                <div class="card-footer text-center bg-light">
                    <a href="/Compare@(p1 != null ? $"?player1={p1Id}" : "")"
                       class="btn btn-sm btn-outline-danger"
                       hx-boost="false">Change Player</a>
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="position-relative">
                        <input type="search" class="form-control form-control-lg"
                               placeholder="Search for Player 2..."
                               name="q"
                               hx-get="/Compare?handler=Search&side=2&player1=@p1Id&player2=@p2Id"
                               hx-trigger="input changed delay:300ms, search"
                               hx-target="#search-results-2"
                               hx-swap="innerHTML"
                               hx-boost="false"
                               autocomplete="off" />
                        <div id="search-results-2" class="position-absolute w-100" style="z-index: 1050;"></div>
                    </div>
                    <div class="text-center text-muted mt-4 mb-2">
                        <div style="font-size: 3rem; opacity: 0.3;">&#9918;</div>
                        <p>Search to select a player</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Comparison tables (only shown when both selected) -->
@if (Model.ViewModel.BothSelected)
{
    <div id="compare-tables">
        @await Html.PartialAsync("_CompareContent", Model.ViewModel)
    </div>
}
