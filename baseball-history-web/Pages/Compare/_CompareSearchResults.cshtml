@model (List<baseball_history_web.ViewModels.PlayerSummary> Results, int Side, string? Player1, string? Player2)

@if (Model.Results.Any())
{
    <div class="list-group shadow" style="max-height: 300px; overflow-y: auto;">
        @foreach (var player in Model.Results)
        {
            string url;
            if (Model.Side == 1)
            {
                url = string.IsNullOrEmpty(Model.Player2)
                    ? $"/Compare?player1={player.PlayerId}"
                    : $"/Compare?player1={player.PlayerId}&player2={Model.Player2}";
            }
            else
            {
                url = string.IsNullOrEmpty(Model.Player1)
                    ? $"/Compare?player2={player.PlayerId}"
                    : $"/Compare?player1={Model.Player1}&player2={player.PlayerId}";
            }

            <a href="@url"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               hx-boost="false">
                <div>
                    <strong>@player.FullName</strong>
                    @if (player.IsInHallOfFame)
                    {
                        <span class="hof-badge ms-1">HOF</span>
                    }
                    @if (!string.IsNullOrEmpty(player.DebutYear))
                    {
                        <span class="text-muted small ms-2">@player.DebutYear - @(player.FinalYear ?? "Present")</span>
                    }
                </div>
                <rhx-badge rhx-variant="brand">Select</rhx-badge>
            </a>
        }
    </div>
}
