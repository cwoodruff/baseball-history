@model (List<baseball_history_web.ViewModels.PlayerSummary> Results, int Side, string? Player1, string? Player2, string? Player3, string? Player4)

@if (Model.Results.Any())
{
    <div class="list-group shadow" style="max-height: 300px; overflow-y: auto;">
        @foreach (var player in Model.Results)
        {
            var queryParams = new Dictionary<string, string?>();
            queryParams[$"player{Model.Side}"] = player.PlayerId;
            
            // Preserve other selected players
            for (int i = 1; i <= 4; i++)
            {
                if (i == Model.Side) continue;
                var otherPlayer = i switch
                {
                    1 => Model.Player1,
                    2 => Model.Player2,
                    3 => Model.Player3,
                    4 => Model.Player4,
                    _ => null
                };
                if (!string.IsNullOrEmpty(otherPlayer))
                    queryParams[$"player{i}"] = otherPlayer;
            }
            
            var url = $"/Compare?{string.Join("&", queryParams.Select(kvp => $"{kvp.Key}={kvp.Value}"))}";

            <a href="@url"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               hx-boost="false">
                <div>
                    <strong>@player.FullName</strong>
                    @if (player.IsPartialRecord)
                    {
                        @await Html.PartialAsync("Components/_PartialRecordBadge", true)
                    }
                    @if (player.IsInHallOfFame)
                    {
                        <span class="hof-badge ms-1">HOF</span>
                    }
                    @if (!string.IsNullOrEmpty(player.DebutYear))
                    {
                        <span class="text-muted small ms-2">@player.DebutYear - @(player.FinalYear ?? "Present")</span>
                    }
                </div>
                <rhx-badge rhx-variant="brand">Select</rhx-badge>
            </a>
        }
    </div>
}
else
{
    <div class="list-group shadow">
        <div class="list-group-item text-muted text-center py-3">
            <small>No players found</small>
        </div>
    </div>
}
