@page "{teamId}/{lgId}/{year:int}"
@model baseball_history_web.Pages.Teams.SeasonModel
@{
    ViewData["Title"] = Model.Team != null ? $"{Model.Team.TeamName} {Model.Team.Year}" : "Team Season";
}

@if (Model.Team == null)
{
    @await Html.PartialAsync("Components/_EmptyState", new baseball_history_web.ViewModels.EmptyStateModel
    {
        Title = "Season Not Found",
        Message = "The requested team season could not be found.",
        ActionUrl = "/Teams",
        ActionText = "Back to Teams"
    })
}
else
{
    @await Html.PartialAsync("_TeamSeason", Model.Team)
}
