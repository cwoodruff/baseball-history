@model IndexModel

@if (Model.ThisDay.HasContent)
{
    var sections = new[]
    {
        ("Birthdays", "b.", Model.ThisDay.Birthdays),
        ("Debuts", "", Model.ThisDay.Debuts),
        ("Final Games", "", Model.ThisDay.Finales)
    };

    <div class="card mb-4" id="this-day-widget">
        <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
            <strong>This Day in Baseball &mdash; @Model.ThisDay.DateLabel</strong>
        </div>
        <div class="card-body">
            <div class="row">
                @foreach (var (title, yearPrefix, entries) in sections)
                {
                    <div class="col-md-4 mb-3 mb-md-0">
                        <h3 class="h6 text-uppercase text-muted mb-2">@title</h3>
                        @if (entries.Count == 0)
                        {
                            <p class="small text-muted mb-0">None on this date.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var entry in entries)
                                {
                                    <li class="mb-1">
                                        <a href="/Players/@entry.PlayerId" class="text-decoration-none"
                                           hx-get="/Players/Modal/@entry.PlayerId"
                                           hx-target="#modal-container"
                                           hx-swap="innerHTML"
                                           hx-boost="false">@entry.FullName</a>
                                        @if (entry.IsInHallOfFame)
                                        {
                                            <span class="hof-badge ms-1" title="Hall of Fame">HOF</span>
                                        }
                                        @if (entry.Year.HasValue)
                                        {
                                            <span class="text-muted small">@yearPrefix @entry.Year</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
