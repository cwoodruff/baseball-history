@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

@await Html.PartialAsync("Components/_PageHeader", new baseball_history_web.ViewModels.PageHeaderModel
{
    Title = ViewData["Title"]?.ToString() ?? "Privacy Policy",
    Subtitle = "Reference page for site privacy details.",
    Eyebrow = "Support"
})

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <p class="text-muted small mb-4">Last updated: June 13, 2026</p>

        <h2 class="h5">Overview</h2>
        <p>
            This site provides read-only access to historical Major League Baseball
            statistics. We do not collect, store, sell, or share any personal information
            about visitors.
        </p>

        <h2 class="h5 mt-4">Information We Collect</h2>
        <p class="mb-0">
            None. Browsing the site, viewing statistics, and running searches or queries
            do not require an account, and none of your searches or queries are saved.
            All data shown is public baseball history, served the same way to everyone.
        </p>

        <h2 class="h5 mt-4">Cookies &amp; Tracking</h2>
        <p class="mb-0">
            We do not use cookies or third-party analytics to track you across the site
            or the web.
        </p>

        <h2 class="h5 mt-4">Third-Party Services</h2>
        <p class="mb-0">
            We do not share data with third parties, because we do not collect any data
            to share.
        </p>

        <h2 class="h5 mt-4">Changes to This Policy</h2>
        <p class="mb-0">
            If this policy changes, the updated version will be posted on this page with a
            revised "last updated" date.
        </p>
    </div>
</div>
