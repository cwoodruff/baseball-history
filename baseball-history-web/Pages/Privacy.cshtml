@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

@await Html.PartialAsync("Components/_PageHeader", new baseball_history_web.ViewModels.PageHeaderModel
{
    Title = ViewData["Title"]?.ToString() ?? "Privacy Policy",
    Subtitle = "Reference page for site privacy details.",
    Eyebrow = "Support"
})

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <p class="mb-0">Use this page to detail your site's privacy policy.</p>
    </div>
</div>
