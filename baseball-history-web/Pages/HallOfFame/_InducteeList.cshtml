@model baseball_history_web.ViewModels.HallOfFameViewModel

@if (!Model.Inductees.Any())
{
    @await Html.PartialAsync("Components/_EmptyState", new baseball_history_web.ViewModels.EmptyStateModel
    {
        Title = "No Inductees Found",
        Message = "No Hall of Fame inductees match your criteria.",
        ActionUrl = "/HallOfFame",
        ActionText = "View All Inductees"
    })
}
else
{
    <div class="card">
        <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
            <strong>Hall of Fame Inductees</strong>
            <rhx-badge rhx-variant="neutral">@Model.TotalInductees.ToString("N0") inductees</rhx-badge>
        </div>
        <div class="table-responsive">
            <table class="table table-baseball table-hover mb-0">
                <thead>
                <tr>
                    <th>Name</th>
                    <th class="text-center">Year</th>
                    <th>Category</th>
                    <th>Voted By</th>
                    <th class="text-end">Vote %</th>
                    <th>Career</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var inductee in Model.Inductees)
                {
                    <tr>
                        <td>
                            <a href="/Players/@inductee.PlayerId" class="text-decoration-none fw-bold"
                               hx-get="/Players/Modal/@inductee.PlayerId"
                               hx-target="#modal-container"
                               hx-swap="innerHTML"
                               hx-boost="false">
                                @inductee.FullName
                            </a>
                            <span class="hof-badge ms-2">HOF</span>
                        </td>
                        <td class="text-center">
                            <span class="fw-bold text-mlb-navy">@inductee.InductionYear</span>
                        </td>
                        <td>
                            @switch (inductee.Category)
                            {
                                case "Player":
                                    <rhx-badge rhx-variant="brand">Player</rhx-badge>
                                    break;
                                case "Manager":
                                    <rhx-badge rhx-variant="success">Manager</rhx-badge>
                                    break;
                                case "Pioneer/Executive":
                                    <rhx-badge rhx-variant="neutral">Pioneer</rhx-badge>
                                    break;
                                case "Umpire":
                                    <rhx-badge rhx-variant="warning">Umpire</rhx-badge>
                                    break;
                                default:
                                    <rhx-badge rhx-variant="neutral">@inductee.Category</rhx-badge>
                                    break;
                            }
                        </td>
                        <td class="small text-muted">@inductee.VotedBy</td>
                        <td class="text-end stat-cell">@inductee.FormattedVotePct</td>
                        <td class="small text-muted">
                            @if (!string.IsNullOrEmpty(inductee.DebutYear) && !string.IsNullOrEmpty(inductee.FinalYear))
                            {
                                <span>@inductee.DebutYear - @inductee.FinalYear</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        var queryParams = new Dictionary<string, string>();
        if (Model.SelectedYear.HasValue) queryParams["year"] = Model.SelectedYear.Value.ToString();
        if (!string.IsNullOrEmpty(Model.SelectedCategory)) queryParams["category"] = Model.SelectedCategory;

        <div class="mt-3">
            @await Html.PartialAsync("Components/_Pagination", new baseball_history_web.ViewModels.PaginationModel
            {
                CurrentPage = Model.CurrentPage,
                TotalPages = Model.TotalPages,
                TotalItems = Model.TotalInductees,
                PageSize = Model.PageSize,
                BaseUrl = "/HallOfFame",
                Target = "#inductee-list",
                QueryParams = queryParams
            })
        </div>
    }
}
