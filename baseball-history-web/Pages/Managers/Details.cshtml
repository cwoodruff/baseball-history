@page "/Managers/{playerId}"
@using baseball_history_web.ViewModels
@model baseball_history_web.Pages.Managers.DetailsModel
@{
    ViewData["Title"] = Model.Manager.FullName;
}

@await Html.PartialAsync("Components/_Breadcrumbs", BreadcrumbModel.Build(
    new BreadcrumbItem("Managers", "/Managers"),
    new BreadcrumbItem(Model.Manager.FullName)))

<div id="manager-content">
    @await Html.PartialAsync("_ManagerDetail", Model.Manager)
</div>
