@model baseball_history_web.ViewModels.LeaderboardViewModel

@if (!Model.BattingLeaders.Any())
{
    @await Html.PartialAsync("Components/_EmptyState", baseball_history_web.ViewModels.EmptyStateModel.NoStats())
}
else
{
    <div class="card">
        <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
            <strong>@Model.Title</strong>
            <rhx-badge rhx-variant="neutral">@Model.TotalEntries.ToString("N0") players</rhx-badge>
        </div>
        <div class="table-responsive">
            <table class="table table-baseball table-hover mb-0">
                <caption class="visually-hidden">@Model.Title</caption>
                <thead>
                <tr>
                    <th class="text-center" style="width: 50px;" scope="col">Rank</th>
                    <th scope="col">Player</th>
                    @if (Model.SingleSeason)
                    {
                        <th scope="col">Year</th>
                        <th scope="col">Team</th>
                    }
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "g" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=g" class="text-black text-decoration-none @(Model.StatColumn == "g" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=g"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            G @if (Model.StatColumn == "g") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "ab" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=ab" class="text-black text-decoration-none @(Model.StatColumn == "ab" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=ab"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            AB @if (Model.StatColumn == "ab") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "h" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=h" class="text-black text-decoration-none @(Model.StatColumn == "h" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=h"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            H @if (Model.StatColumn == "h") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "2b" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=2b" class="text-black text-decoration-none @(Model.StatColumn == "2b" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=2b"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            2B @if (Model.StatColumn == "2b") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "3b" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=3b" class="text-black text-decoration-none @(Model.StatColumn == "3b" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=3b"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            3B @if (Model.StatColumn == "3b") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "hr" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=hr" class="text-black text-decoration-none @(Model.StatColumn == "hr" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=hr"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            HR @if (Model.StatColumn == "hr") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "rbi" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=rbi" class="text-black text-decoration-none @(Model.StatColumn == "rbi" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=rbi"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            RBI @if (Model.StatColumn == "rbi") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "r" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=r" class="text-black text-decoration-none @(Model.StatColumn == "r" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=r"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            R @if (Model.StatColumn == "r") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "sb" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=sb" class="text-black text-decoration-none @(Model.StatColumn == "sb" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=sb"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            SB @if (Model.StatColumn == "sb") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "bb" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=bb" class="text-black text-decoration-none @(Model.StatColumn == "bb" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=bb"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            BB @if (Model.StatColumn == "bb") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "avg" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=avg" class="text-black text-decoration-none @(Model.StatColumn == "avg" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=avg"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            AVG @if (Model.StatColumn == "avg") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "ops" ? "descending" : null)">
                        <a href="/Stats/Batting?stat=ops" class="text-black text-decoration-none @(Model.StatColumn == "ops" ? "fw-bold" : "")"
                           hx-get="/Stats/Batting?stat=ops"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            OPS @if (Model.StatColumn == "ops") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                </tr>
                </thead>
                <tbody>
                @foreach (var leader in Model.BattingLeaders)
                {
                    <tr data-team="@leader.TeamId">
                        <td class="text-center rank-cell">@leader.Rank</td>
                        <td>
                            <a href="/Players/@leader.PlayerId" class="text-decoration-none"
                               hx-get="/Players/Modal/@leader.PlayerId"
                               hx-target="#modal-container"
                               hx-swap="innerHTML"
                               hx-boost="false">
                                @leader.PlayerName
                            </a>
                            @if (leader.IsInHallOfFame)
                            {
                                <rhx-badge rhx-variant="warning" rhx-size="sm" class="ms-1">HOF</rhx-badge>
                            }
                        </td>
                        @if (Model.SingleSeason)
                        {
                            <td>@leader.Year</td>
                            <td>@(leader.TeamName ?? leader.TeamId)</td>
                        }
                        <td class="text-end stat-cell @(Model.StatColumn == "g" ? "fw-bold" : "")">@leader.Games.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "ab" ? "fw-bold" : "")">@leader.AtBats.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "h" ? "fw-bold" : "")">@leader.Hits.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "2b" ? "fw-bold" : "")">@leader.Doubles.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "3b" ? "fw-bold" : "")">@leader.Triples.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "hr" ? "fw-bold" : "")">@leader.HomeRuns.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "rbi" ? "fw-bold" : "")">@leader.Rbi.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "r" ? "fw-bold" : "")">@leader.Runs.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "sb" ? "fw-bold" : "")">@leader.StolenBases.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "bb" ? "fw-bold" : "")">@leader.Walks.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "avg" ? "fw-bold" : "")">@leader.FormattedAvg</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "ops" ? "fw-bold" : "")">@leader.FormattedOps</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        var queryParams = new Dictionary<string, string>
        {
            ["stat"] = Model.StatColumn
        };
        if (Model.FromYear.HasValue) queryParams["fromYear"] = Model.FromYear.Value.ToString();
        if (Model.ToYear.HasValue) queryParams["toYear"] = Model.ToYear.Value.ToString();
        if (!string.IsNullOrEmpty(Model.League)) queryParams["league"] = Model.League;
        if (Model.MinimumAtBats > 0) queryParams["minAb"] = Model.MinimumAtBats.ToString();
        if (Model.SingleSeason) queryParams["singleSeason"] = "true";

        <div class="mt-3">
            @await Html.PartialAsync("Components/_Pagination", new baseball_history_web.ViewModels.PaginationModel
            {
                CurrentPage = Model.CurrentPage,
                TotalPages = Model.TotalPages,
                TotalItems = Model.TotalEntries,
                PageSize = Model.PageSize,
                BaseUrl = "/Stats/Batting",
                Target = "#leaderboard",
                QueryParams = queryParams
            })
        </div>
    }
}
