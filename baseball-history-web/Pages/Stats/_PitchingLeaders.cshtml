@model baseball_history_web.ViewModels.LeaderboardViewModel

@if (!Model.PitchingLeaders.Any())
{
    @await Html.PartialAsync("Components/_EmptyState", baseball_history_web.ViewModels.EmptyStateModel.NoStats())
}
else
{
    <div class="card">
        <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
            <strong>@Model.Title</strong>
            <span class="badge bg-light text-dark">@Model.TotalEntries.ToString("N0") pitchers</span>
        </div>
        <div class="table-responsive">
            <table class="table table-baseball table-hover mb-0">
                <thead>
                <tr>
                    <th class="text-center" style="width: 50px;">Rank</th>
                    <th>Player</th>
                    @if (Model.SingleSeason)
                    {
                        <th>Year</th>
                        <th>Team</th>
                    }
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "g" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=g"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            G @(Model.StatColumn == "g" ? "↓" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "gs" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=gs"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            GS @(Model.StatColumn == "gs" ? "↓" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "w" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=w"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            W @(Model.StatColumn == "w" ? "↓" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "l" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=l"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            L @(Model.StatColumn == "l" ? "↑" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "sv" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=sv"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            SV @(Model.StatColumn == "sv" ? "↓" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "ip" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=ip"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            IP @(Model.StatColumn == "ip" ? "↓" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "so" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=so"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            SO @(Model.StatColumn == "so" ? "↓" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#" class="text-black text-decoration-none @(Model.StatColumn == "bb" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=bb"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            BB @(Model.StatColumn == "bb" ? "↑" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#"
                           class="text-black text-decoration-none @(Model.StatColumn == "era" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=era"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            ERA @(Model.StatColumn == "era" ? "↑" : "")
                        </a>
                    </th>
                    <th class="text-end">
                        <a href="#"
                           class="text-black text-decoration-none @(Model.StatColumn == "whip" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=whip"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            WHIP @(Model.StatColumn == "whip" ? "↑" : "")
                        </a>
                    </th>
                </tr>
                </thead>
                <tbody>
                @foreach (var leader in Model.PitchingLeaders)
                {
                    <tr data-team="@leader.TeamId">
                        <td class="text-center rank-cell">@leader.Rank</td>
                        <td>
                            <a href="#" class="text-decoration-none"
                               hx-get="/Players/Modal/@leader.PlayerId"
                               hx-target="#modal-container"
                               hx-swap="innerHTML"
                               hx-boost="false">
                                @leader.PlayerName
                            </a>
                            @if (leader.IsInHallOfFame)
                            {
                                <span class="hof-badge ms-1">HOF</span>
                            }
                        </td>
                        @if (Model.SingleSeason)
                        {
                            <td>@leader.Year</td>
                            <td>@(leader.TeamName ?? leader.TeamId)</td>
                        }
                        <td class="text-end stat-cell @(Model.StatColumn == "g" ? "fw-bold" : "")">@leader.Games.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "gs" ? "fw-bold" : "")">@leader.GamesStarted.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "w" ? "fw-bold" : "")">@leader.Wins.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "l" ? "fw-bold" : "")">@leader.Losses.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "sv" ? "fw-bold" : "")">@leader.Saves.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "ip" ? "fw-bold" : "")">@leader.FormattedIp</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "so" ? "fw-bold" : "")">@leader.Strikeouts.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "bb" ? "fw-bold" : "")">@leader.Walks.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "era" ? "fw-bold" : "")">@leader.FormattedEra</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "whip" ? "fw-bold" : "")">@leader.FormattedWhip</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        var queryParams = new Dictionary<string, string>
        {
            ["stat"] = Model.StatColumn
        };
        if (Model.FromYear.HasValue) queryParams["fromYear"] = Model.FromYear.Value.ToString();
        if (Model.ToYear.HasValue) queryParams["toYear"] = Model.ToYear.Value.ToString();
        if (!string.IsNullOrEmpty(Model.League)) queryParams["league"] = Model.League;
        if (Model.MinimumInningsPitched > 0) queryParams["minIp"] = Model.MinimumInningsPitched.ToString();
        if (Model.SingleSeason) queryParams["singleSeason"] = "true";

        <div class="mt-3">
            @await Html.PartialAsync("Components/_Pagination", new baseball_history_web.ViewModels.PaginationModel
            {
                CurrentPage = Model.CurrentPage,
                TotalPages = Model.TotalPages,
                TotalItems = Model.TotalEntries,
                PageSize = Model.PageSize,
                BaseUrl = "/Stats/Pitching",
                Target = "#leaderboard",
                QueryParams = queryParams
            })
        </div>
    }
}
