@model baseball_history_web.ViewModels.LeaderboardViewModel

@if (!Model.PitchingLeaders.Any())
{
    @await Html.PartialAsync("Components/_EmptyState", baseball_history_web.ViewModels.EmptyStateModel.NoStats())
}
else
{
    <div class="card">
        <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
            <strong>@Model.Title</strong>
            <rhx-badge rhx-variant="neutral">@Model.TotalEntries.ToString("N0") pitchers</rhx-badge>
        </div>
        @if (Model.IsQualified)
        {
            <div class="card-body py-2 bg-light border-bottom">
                <small class="text-muted">
                    <strong>Qualification:</strong> Showing pitchers who met the season qualification standard (3.1 plate appearances per team game).
                    This allows historically significant pitchers from shorter schedules (including Negro Leagues) to appear in rate-stat leaderboards.
                </small>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-baseball table-hover mb-0">
                <caption class="visually-hidden">@Model.Title</caption>
                <thead>
                <tr>
                    <th class="text-center" style="width: 50px;" scope="col">Rank</th>
                    <th scope="col">Player</th>
                    @if (Model.SingleSeason)
                    {
                        <th scope="col">Year</th>
                        <th scope="col">Team</th>
                    }
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "g" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=g" class="text-black text-decoration-none @(Model.StatColumn == "g" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=g"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            G @if (Model.StatColumn == "g") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "gs" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=gs" class="text-black text-decoration-none @(Model.StatColumn == "gs" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=gs"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            GS @if (Model.StatColumn == "gs") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "w" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=w" class="text-black text-decoration-none @(Model.StatColumn == "w" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=w"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            W @if (Model.StatColumn == "w") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "l" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=l" class="text-black text-decoration-none @(Model.StatColumn == "l" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=l"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            L @if (Model.StatColumn == "l") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "sv" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=sv" class="text-black text-decoration-none @(Model.StatColumn == "sv" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=sv"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            SV @if (Model.StatColumn == "sv") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "ip" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=ip" class="text-black text-decoration-none @(Model.StatColumn == "ip" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=ip"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            IP @if (Model.StatColumn == "ip") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "so" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=so" class="text-black text-decoration-none @(Model.StatColumn == "so" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=so"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            SO @if (Model.StatColumn == "so") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "bb" ? "descending" : null)">
                        <a href="/Stats/Pitching?stat=bb" class="text-black text-decoration-none @(Model.StatColumn == "bb" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=bb"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            BB @if (Model.StatColumn == "bb") {<span aria-hidden="true">▼</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "era" ? "ascending" : null)">
                        <a href="/Stats/Pitching?stat=era" class="text-black text-decoration-none @(Model.StatColumn == "era" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=era"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            ERA @if (Model.StatColumn == "era") {<span aria-hidden="true">▲</span>}
                        </a>
                    </th>
                    <th class="text-end" scope="col" aria-sort="@(Model.StatColumn == "whip" ? "ascending" : null)">
                        <a href="/Stats/Pitching?stat=whip" class="text-black text-decoration-none @(Model.StatColumn == "whip" ? "fw-bold" : "")"
                           hx-get="/Stats/Pitching?stat=whip"
                           hx-include="#filter-form"
                           hx-target="#leaderboard"
                           hx-push-url="true">
                            WHIP @if (Model.StatColumn == "whip") {<span aria-hidden="true">▲</span>}
                        </a>
                    </th>
                </tr>
                </thead>
                <tbody>
                @foreach (var leader in Model.PitchingLeaders)
                {
                    <tr data-team="@leader.TeamId">
                        <td class="text-center rank-cell">@leader.Rank</td>
                        <td>
                            <a href="/Players/@leader.PlayerId" class="text-decoration-none"
                               hx-get="/Players/Modal/@leader.PlayerId"
                               hx-target="#modal-container"
                               hx-swap="innerHTML"
                               hx-boost="false">
                                @leader.PlayerName
                            </a>
                            @if (leader.IsInHallOfFame)
                            {
                                <rhx-badge rhx-variant="warning" rhx-size="sm" class="ms-1">HOF</rhx-badge>
                            }
                        </td>
                        @if (Model.SingleSeason)
                        {
                            <td>@leader.Year</td>
                            <td>@(leader.TeamName ?? leader.TeamId)</td>
                        }
                        <td class="text-end stat-cell @(Model.StatColumn == "g" ? "fw-bold" : "")">@leader.Games.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "gs" ? "fw-bold" : "")">@leader.GamesStarted.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "w" ? "fw-bold" : "")">@leader.Wins.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "l" ? "fw-bold" : "")">@leader.Losses.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "sv" ? "fw-bold" : "")">@leader.Saves.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "ip" ? "fw-bold" : "")">@leader.FormattedIp</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "so" ? "fw-bold" : "")">@leader.Strikeouts.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "bb" ? "fw-bold" : "")">@leader.Walks.ToString("N0")</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "era" ? "fw-bold" : "")">@leader.FormattedEra</td>
                        <td class="text-end stat-cell @(Model.StatColumn == "whip" ? "fw-bold" : "")">@leader.FormattedWhip</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        var queryParams = new Dictionary<string, string>
        {
            ["stat"] = Model.StatColumn
        };
        if (Model.FromYear.HasValue) queryParams["fromYear"] = Model.FromYear.Value.ToString();
        if (Model.ToYear.HasValue) queryParams["toYear"] = Model.ToYear.Value.ToString();
        if (!string.IsNullOrEmpty(Model.League)) queryParams["league"] = Model.League;
        if (Model.MinimumInningsPitched != -1) queryParams["minIp"] = Model.MinimumInningsPitched.ToString();
        if (Model.SingleSeason) queryParams["singleSeason"] = "true";

        <div class="mt-3">
            @await Html.PartialAsync("Components/_Pagination", new baseball_history_web.ViewModels.PaginationModel
            {
                CurrentPage = Model.CurrentPage,
                TotalPages = Model.TotalPages,
                TotalItems = Model.TotalEntries,
                PageSize = Model.PageSize,
                BaseUrl = "/Stats/Pitching",
                Target = "#leaderboard",
                QueryParams = queryParams
            })
        </div>
    }
}
