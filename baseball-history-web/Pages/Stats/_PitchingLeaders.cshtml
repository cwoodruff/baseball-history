@model baseball_history_web.ViewModels.LeaderboardViewModel

@if (!Model.PitchingLeaders.Any())
{
    @await Html.PartialAsync("Components/_EmptyState", baseball_history_web.ViewModels.EmptyStateModel.NoStats())
}
else
{
    <div class="card">
        <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
            <strong>@Model.Title</strong>
            <span class="badge bg-light text-dark">@Model.TotalEntries.ToString("N0") pitchers</span>
        </div>
        <div class="table-responsive">
            <table class="table table-baseball table-hover mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">Rank</th>
                        <th>Player</th>
                        @if (Model.SingleSeason)
                        {
                            <th>Year</th>
                            <th>Team</th>
                        }
                        <th class="text-end">G</th>
                        <th class="text-end">GS</th>
                        <th class="text-end bg-mlb-navy text-white">W</th>
                        <th class="text-end">L</th>
                        <th class="text-end">SV</th>
                        <th class="text-end">IP</th>
                        <th class="text-end">SO</th>
                        <th class="text-end">BB</th>
                        <th class="text-end">ERA</th>
                        <th class="text-end">WHIP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leader in Model.PitchingLeaders)
                    {
                        <tr data-team="@leader.TeamId">
                            <td class="text-center rank-cell">@leader.Rank</td>
                            <td>
                                <a href="#" class="text-decoration-none"
                                   hx-get="/Players/Modal/@leader.PlayerId"
                                   hx-target="#modal-container"
                                   hx-swap="innerHTML"
                                   hx-boost="false">
                                    @leader.PlayerName
                                </a>
                                @if (leader.IsInHallOfFame)
                                {
                                    <span class="hof-badge ms-1">HOF</span>
                                }
                            </td>
                            @if (Model.SingleSeason)
                            {
                                <td>@leader.Year</td>
                                <td>@(leader.TeamName ?? leader.TeamId)</td>
                            }
                            <td class="text-end stat-cell">@leader.Games.ToString("N0")</td>
                            <td class="text-end stat-cell">@leader.GamesStarted.ToString("N0")</td>
                            <td class="text-end stat-cell fw-bold">@leader.Wins.ToString("N0")</td>
                            <td class="text-end stat-cell">@leader.Losses.ToString("N0")</td>
                            <td class="text-end stat-cell">@leader.Saves.ToString("N0")</td>
                            <td class="text-end stat-cell">@leader.FormattedIp</td>
                            <td class="text-end stat-cell">@leader.Strikeouts.ToString("N0")</td>
                            <td class="text-end stat-cell">@leader.Walks.ToString("N0")</td>
                            <td class="text-end stat-cell">@leader.FormattedEra</td>
                            <td class="text-end stat-cell">@leader.FormattedWhip</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        var queryParams = new Dictionary<string, string>
        {
            ["stat"] = Model.StatColumn
        };
        if (Model.FromYear.HasValue) queryParams["fromYear"] = Model.FromYear.Value.ToString();
        if (Model.ToYear.HasValue) queryParams["toYear"] = Model.ToYear.Value.ToString();
        if (!string.IsNullOrEmpty(Model.League)) queryParams["league"] = Model.League;
        if (Model.MinimumInningsPitched > 0) queryParams["minIp"] = Model.MinimumInningsPitched.ToString();
        if (Model.SingleSeason) queryParams["singleSeason"] = "true";

        <div class="mt-3">
            @await Html.PartialAsync("Components/_Pagination", new baseball_history_web.ViewModels.PaginationModel
            {
                CurrentPage = Model.CurrentPage,
                TotalPages = Model.TotalPages,
                TotalItems = Model.TotalEntries,
                PageSize = Model.PageSize,
                BaseUrl = "/Stats/Pitching",
                Target = "#leaderboard",
                QueryParams = queryParams
            })
        </div>
    }
}
