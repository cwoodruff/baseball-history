@page
@model baseball_history_web.Pages.Stats.PitchingModel
@{
    ViewData["Title"] = "Pitching Leaders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-mlb-navy mb-0">Pitching Leaders</h1>
</div>

<!-- Filters -->
<div class="position-relative" hx-indicator="#loading-indicator">
    <div class="card mb-0">
        <div class="card-body">
            <form id="filter-form">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label">Stat</label>
                        <select class="form-select" name="stat"
                                hx-get="/Stats/Pitching"
                                hx-include="#filter-form"
                                hx-target="#leaderboard"
                                hx-indicator="#loading-indicator"
                                hx-push-url="true">
                            @foreach (var s in Model.ViewModel.AvailableStats)
                            {
                                <option value="@s.Key" selected="@(s.Key == Model.ViewModel.StatColumn)">@s.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">From Year</label>
                        <select class="form-select" name="fromYear"
                                hx-get="/Stats/Pitching"
                                hx-include="#filter-form"
                                hx-target="#leaderboard"
                                hx-indicator="#loading-indicator"
                                hx-push-url="true">
                            <option value="">All Time</option>
                            @foreach (var year in Model.ViewModel.AvailableYears)
                            {
                                <option value="@year" selected="@(year == Model.ViewModel.FromYear)">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">To Year</label>
                        <select class="form-select" name="toYear"
                                hx-get="/Stats/Pitching"
                                hx-include="#filter-form"
                                hx-target="#leaderboard"
                                hx-indicator="#loading-indicator"
                                hx-push-url="true">
                            <option value="">Present</option>
                            @foreach (var year in Model.ViewModel.AvailableYears)
                            {
                                <option value="@year" selected="@(year == Model.ViewModel.ToYear)">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">League</label>
                        <select class="form-select" name="league"
                                hx-get="/Stats/Pitching"
                                hx-include="#filter-form"
                                hx-target="#leaderboard"
                                hx-indicator="#loading-indicator"
                                hx-push-url="true">
                            <option value="">All Leagues</option>
                            @foreach (var lg in Model.ViewModel.AvailableLeagues)
                            {
                                <option value="@lg" selected="@(lg == Model.ViewModel.League)">@lg</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Min IP</label>
                        <select class="form-select" name="minIp"
                                hx-get="/Stats/Pitching"
                                hx-include="#filter-form"
                                hx-target="#leaderboard"
                                hx-indicator="#loading-indicator"
                                hx-push-url="true">
                            <option value="0" selected="@(Model.ViewModel.MinimumInningsPitched == 0)">No minimum</option>
                            <option value="50" selected="@(Model.ViewModel.MinimumInningsPitched == 50)">50 IP</option>
                            <option value="100" selected="@(Model.ViewModel.MinimumInningsPitched == 100)">100 IP</option>
                            <option value="500" selected="@(Model.ViewModel.MinimumInningsPitched == 500)">500 IP</option>
                            <option value="1000" selected="@(Model.ViewModel.MinimumInningsPitched == 1000)">1000 IP</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="singleSeason" value="true"
                                   id="singleSeason" checked="@Model.ViewModel.SingleSeason"
                                   hx-get="/Stats/Pitching"
                                   hx-include="#filter-form"
                                   hx-target="#leaderboard"
                                   hx-indicator="#loading-indicator"
                                   hx-push-url="true">
                            <label class="form-check-label" for="singleSeason">
                                Single Season
                            </label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Loading overlay on filter -->
    <div id="loading-indicator" class="htmx-indicator loading-overlay">
        @await Html.PartialAsync("Components/_LoadingSpinner", "Loading stats...")
    </div>
</div>

<div id="leaderboard">
    @await Html.PartialAsync("_PitchingLeaders", Model.ViewModel)
</div>
