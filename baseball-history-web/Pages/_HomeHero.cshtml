@model IndexModel

<div class="card mb-4 border-0">
    <div class="card-body text-center py-5"
         style="background: linear-gradient(135deg, var(--mlb-navy) 0%, var(--mlb-navy-light) 100%);">
        <h1 class="display-4 text-white mb-3">
            <span class="me-3">&#9918;</span>Baseball History
        </h1>
        <p class="lead text-white-50 mb-4">
            Explore @Model.TotalSeasons years of Major League Baseball history (@Model.FirstYear - @Model.LastYear)
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Players" class="btn btn-light btn-lg">
                Browse Players
            </a>
            <a href="/Teams" class="btn btn-outline-light btn-lg">
                View Teams
            </a>
        </div>
    </div>
</div>
