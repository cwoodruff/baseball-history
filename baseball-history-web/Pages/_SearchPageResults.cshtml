@model baseball_history_web.ViewModels.SearchViewModel

@if (Model.Query.Length < 2)
{
    <div class="text-center text-muted py-5">
        Enter at least two characters to search players and teams.
    </div>
}
else if (!Model.HasResults)
{
    @await Html.PartialAsync("Components/_EmptyState", new baseball_history_web.ViewModels.EmptyStateModel
    {
        Title = "No Results Found",
        Message = $"Nothing matched \"{Model.Query}\". Check the spelling or try just a last name.",
        ActionUrl = "/Players",
        ActionText = "Browse All Players"
    })
}
else
{
    <div class="row">
        <div class="@(Model.Teams.Any() ? "col-lg-8" : "col-12") mb-4">
            @if (Model.Players.Any())
            {
                <div class="card">
                    <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
                        <strong>Players</strong>
                        <rhx-badge rhx-variant="neutral">@Model.TotalPlayerCount.ToString("N0") players</rhx-badge>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var player in Model.Players)
                        {
                            @await Html.PartialAsync("Components/_SearchResultLink", new baseball_history_web.ViewModels.SearchResultLinkModel
                            {
                                Result = player,
                                ItemClass = "list-group-item list-group-item-action d-flex align-items-center",
                                IconClass = "result-icon me-3"
                            })
                        }
                    </div>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="mt-3">
                        @await Html.PartialAsync("Components/_Pagination", new baseball_history_web.ViewModels.PaginationModel
                        {
                            CurrentPage = Model.CurrentPage,
                            TotalPages = Model.TotalPages,
                            TotalItems = Model.TotalPlayerCount,
                            PageSize = Model.PageSize,
                            BaseUrl = "/Search",
                            Target = "#search-page-content",
                            QueryParams = new Dictionary<string, string> { ["q"] = Model.Query }
                        })
                    </div>
                }
            }
        </div>

        @if (Model.Teams.Any())
        {
            <div class="@(Model.Players.Any() ? "col-lg-4" : "col-12") mb-4">
                <div class="card">
                    <div class="card-header card-header-mlb d-flex justify-content-between align-items-center">
                        <strong>Teams</strong>
                        <rhx-badge rhx-variant="neutral">@Model.TotalTeamCount.ToString("N0") teams</rhx-badge>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var team in Model.Teams)
                        {
                            @await Html.PartialAsync("Components/_SearchResultLink", new baseball_history_web.ViewModels.SearchResultLinkModel
                            {
                                Result = team,
                                ItemClass = "list-group-item list-group-item-action d-flex align-items-center",
                                IconClass = "result-icon bg-team-gradient me-3"
                            })
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
