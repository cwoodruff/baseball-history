        "AR_BROWSER_PROJECT_ID": "proj-1783549239398-6quhvm",
        "AR_PROJECT_PATH": "/Users/cwoodruff/Git/baseball-history"
      }
    },
    "AgentsRoom-QA-Tester": {
      "command": "node",
      "args": [
        "/Applications/AgentsRoom.app/Contents/Resources/qa-tester-mcp-server.cjs"
      ],
      "env": {
        "AR_BROWSER_BRIDGE_FILE": "/Users/cwoodruff/.agentsroom/browser-bridge.json",
        "AR_BROWSER_PROJECT_ID": "proj-1783549239398-6quhvm"
      }
    }
  }
